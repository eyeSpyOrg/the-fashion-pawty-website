---
/**
 * SponsorCard.astro — one sponsorship tier card on /sponsor/.
 *
 * Layout: a header row with the logo placeholder on the left and the
 * title/subtitle/short copy to its right — kept compact so the row below
 * (Sponsorship Benefits bullets + price/CTA) gets most of the card's width.
 * Extracted from sponsor.astro because this markup repeated across five
 * sections.
 */
interface Props {
  title: string;
  subtitle?: string;
  shortCopy: string;
  benefits: string[];
  price: number;
  buttonText: string;
  stripeUrl: string;
  image?: string;
  /** This tier is claimed — swap the price/buy button for a "Sponsored By" credit. */
  sold?: boolean;
  soldByName?: string;
  soldByLogo?: string;
  soldByHref?: string;
  soldByButtonText?: string;
}
const {
  title,
  subtitle,
  shortCopy,
  benefits,
  price,
  buttonText,
  stripeUrl,
  image = '/images/sponsors/sponsor-placeholder.webp',
  sold = false,
  soldByName,
  soldByLogo,
  soldByHref,
  soldByButtonText,
} = Astro.props;
const money = (n: number) => `$${n.toLocaleString('en-US')}`;
const isPlaceholder = image === '/images/sponsors/sponsor-placeholder.webp';
---

<li class="sponsor-card">
  <div class="sponsor-card__header">
    <div class="sponsor-card__image">
      <img
        src={image}
        alt={isPlaceholder ? `Placeholder — ${title} sponsor logo goes here` : `${title} sponsorship`}
        width="1000"
        height="1000"
        loading="lazy"
      />
    </div>
    <div class="sponsor-card__intro">
      <h3 class="sponsor-card__title">{title}</h3>
      {subtitle && <p class="sponsor-card__subtitle">{subtitle}</p>}
      <p class="sponsor-card__copy">{shortCopy}</p>
    </div>
  </div>

  <div class="sponsor-card__body">
    <div class="sponsor-card__benefits-wrap">
      {benefits.length > 0 && (
        <>
          <p class="sponsor-card__benefits-label">Sponsorship Benefits:</p>
          <ul class="sponsor-card__benefits">
            {benefits.map((b) => <li>{b}</li>)}
          </ul>
        </>
      )}
    </div>

    <div class="sponsor-card__action">
      {sold ? (
        <div class="sponsor-card__sold">
          <p class="sponsor-card__sold-label">Sponsored By:</p>
          <img
            class="sponsor-card__sold-logo"
            src={soldByLogo}
            alt={soldByName}
            width="600"
            height="600"
            loading="lazy"
          />
          <a class="btn btn--secondary" href={soldByHref}>
            {soldByButtonText}
          </a>
        </div>
      ) : (
        <>
          <p class="sponsor-card__price">{money(price)}</p>
          <a class="btn btn--primary" href={stripeUrl} target="_blank" rel="noopener">
            {buttonText}
          </a>
        </>
      )}
    </div>
  </div>
</li>

<style>
  .sponsor-card {
    background: var(--color-surface);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .sponsor-card:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
  html[data-a11y-motion='off'] .sponsor-card:hover { transform: none; }
  @media (prefers-reduced-motion: reduce) { .sponsor-card:hover { transform: none; } }

  /* ── Header: stacked (image above title) on mobile, like a standard
     card — a small side-by-side logo squeezed the copy too narrow on
     small screens. Reverts to a compact row (logo left) at tablet+. ── */
  .sponsor-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  @media (min-width: 40rem) {
    .sponsor-card__header { flex-direction: row; align-items: center; }
  }

  .sponsor-card__image {
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  @media (min-width: 40rem) {
    .sponsor-card__image { width: 5.5rem; }
  }
  .sponsor-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sponsor-card__intro {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .sponsor-card__title {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
  }

  .sponsor-card__subtitle {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .sponsor-card__copy {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  /* ── Body: benefits (left, most of the width) | price+button (right) ── */
  .sponsor-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border-hairline);
  }
  @media (min-width: 40rem) {
    .sponsor-card__body { flex-direction: row; align-items: flex-start; justify-content: space-between; }
  }

  .sponsor-card__benefits-wrap {
    flex: 1;
    min-width: 0;
    width: 100%;
  }
  @media (min-width: 40rem) {
    .sponsor-card__benefits-wrap { width: auto; }
  }

  .sponsor-card__benefits-label {
    margin: 0 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  .sponsor-card__benefits {
    list-style: disc;
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  /* Price centered above the button. */
  .sponsor-card__action {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    width: 100%;
  }
  @media (min-width: 40rem) {
    .sponsor-card__action { width: auto; min-width: 11rem; }
  }

  .sponsor-card__price {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--color-accent);
  }

  .sponsor-card__action .btn {
    width: 100%;
  }
  @media (min-width: 40rem) {
    .sponsor-card__action .btn { width: auto; }
  }

  /* Sold tier: "Sponsored By" credit instead of price + buy button. */
  .sponsor-card__sold {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    width: 100%;
  }
  @media (min-width: 40rem) {
    .sponsor-card__sold { width: auto; min-width: 11rem; }
  }
  .sponsor-card__sold-label {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }
  .sponsor-card__sold-logo {
    width: 6rem;
    height: 6rem;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }
  .sponsor-card__sold .btn { width: 100%; }
  @media (min-width: 40rem) {
    .sponsor-card__sold .btn { width: auto; }
  }
</style>
