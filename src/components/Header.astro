---
/**
 * Universal Header — semantic landmark, keyboard-first nav,
 * accessible mobile disclosure menu + desktop About dropdown
 * (WAI-ARIA APG disclosure navigation pattern).
 * Nav items come from src/config/site.js; items with `children`
 * render as a button-triggered dropdown.
 */
import { SITE } from '../config/site.js';

interface NavChild {
  label: string;
  href: string;
  external?: boolean;
}
interface NavItem {
  label: string;
  href?: string;
  external?: boolean;
  children?: NavChild[];
}

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

// A nav group is "active" when any child is active
const groupActive = (children: NavChild[]) => children.some((c) => isActive(c.href));
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand">
      <img
        class="site-header__logo site-header__logo--color"
        src="/logo.webp"
        alt={`${SITE.name} — home`}
        width="134"
        height="48"
      />
      <img
        class="site-header__logo site-header__logo--hc"
        src="/logo-high-contrast.webp"
        alt={`${SITE.name} — home`}
        width="134"
        height="48"
      />
    </a>

    <nav id="primary-nav" class="site-header__nav" aria-label="Primary" data-menu>
      <ul>
        {(SITE.nav as NavItem[]).map((item) => (
          item.children ? (
            <li class="has-dropdown">
              <button
                type="button"
                class="nav-dropdown-toggle"
                aria-expanded="false"
                aria-haspopup="true"
                data-dropdown-toggle
                class:list={[groupActive(item.children) && 'is-group-active']}
              >
                {item.label}
                <span class="nav-caret" aria-hidden="true">▾</span>
              </button>
              <ul class="nav-dropdown" data-dropdown-menu>
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={isActive(child.href) ? 'page' : undefined}
                      rel={child.external ? 'noopener' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href!) ? 'page' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--ticket site-header__tickets" href={SITE.event.ticketUrl} target="_blank" rel="noopener">Buy Tickets</a>
      <a class="btn btn--secondary site-header__donate" href="/donate/">
        Donate
      </a>
      <a class="btn btn--ticket site-header__tickets-mobile" href={SITE.event.ticketUrl} target="_blank" rel="noopener">Get Tickets</a>

      <button
        type="button"
        class="site-header__menu-btn"
        aria-expanded="false"
        aria-controls="primary-nav"
        data-menu-toggle
      >
        <span aria-hidden="true" data-menu-icon>☰</span>
        Menu
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 2px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: nowrap;
  }
  .site-header__brand {
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .site-header__logo { height: 48px; width: auto; }
  .site-header__logo--hc { display: none; }
  :global(html[data-a11y-contrast='high']) .site-header__logo--color { display: none; }
  :global(html[data-a11y-contrast='high']) .site-header__logo--hc { display: inline; }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
  }
  .site-header__actions .btn { padding: 0.5rem 1rem; }
  .site-header__tickets-mobile { display: none; }

  .site-header__menu-btn {
    display: none;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 8px;
    padding: 0.5rem 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    min-height: 44px;
  }

  /* ── Nav list ── */
  .site-header__nav > ul {
    display: flex;
    gap: 0.05rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
  }
  .site-header__nav > ul > li { position: relative; }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.5rem;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    border-radius: 8px;
    white-space: nowrap;
  }
  .site-header__nav a:hover { background: var(--color-surface); }
  .site-header__nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 2px;
    color: var(--color-accent);
  }

  /* ── Dropdown toggle button ── */
  .nav-dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--color-text);
    border-radius: 8px;
    white-space: nowrap;
    min-height: 44px;
  }
  .nav-dropdown-toggle:hover,
  .nav-dropdown-toggle[aria-expanded='true'] { background: var(--color-surface); }
  .nav-dropdown-toggle.is-group-active {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 2px;
    color: var(--color-accent);
  }
  .nav-caret {
    font-size: 0.7em;
    transition: transform 0.15s ease;
  }
  .nav-dropdown-toggle[aria-expanded='true'] .nav-caret { transform: rotate(180deg); }
  :global(html[data-a11y-motion='off']) .nav-caret { transition: none; }

  /* ── Dropdown menu panel ── */
  .nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 14rem;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    z-index: 100;
  }
  .has-dropdown[data-open='true'] .nav-dropdown { display: block; }
  .nav-dropdown a {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    font-size: 0.925rem;
    white-space: normal;
  }
  html[data-a11y-contrast='high'] .nav-dropdown {
    background: var(--color-surface);
    border-color: var(--color-border);
    box-shadow: none;
  }

  /* ── Mobile collapse ── */
  @media (max-width: 60rem) {
    .site-header__inner { flex-wrap: wrap; }
    .site-header__menu-btn { display: inline-flex; }
    .site-header__nav { display: none; width: 100%; order: 3; }
    .site-header__nav.is-open { display: block; }
    .site-header__nav > ul { flex-direction: column; }
    .site-header__nav a { width: 100%; }
    .site-header__donate, .site-header__tickets { display: none; }
    .site-header__tickets-mobile { display: inline-flex; }

    /* Mobile dropdown: inline below the toggle, not a floating panel */
    .nav-dropdown-toggle { width: 100%; justify-content: space-between; }
    .nav-dropdown {
      position: static;
      display: none;
      box-shadow: none;
      border: none;
      border-radius: 0;
      padding: 0 0 0 1rem;
      background: none;
    }
    .has-dropdown[data-open='true'] .nav-dropdown { display: block; }
  }
  @media (max-width: 30rem) {
    .site-header__actions { gap: 0.3rem; }
    .site-header__actions .btn--secondary,
    .site-header__actions .btn--ticket { padding: 0.5rem 0.8rem; font-size: 0.95rem; }
    .site-header__menu-btn { padding: 0.5rem 0.7rem; }
  }
</style>

<script>
  // Mobile hamburger toggle
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-menu]');
  if (menuBtn && nav) {
    menuBtn.addEventListener('click', () => {
      const open = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('is-open', !open);
    });
    nav.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        nav.classList.remove('is-open');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.focus();
      }
    });
  }

  // Desktop dropdown — WAI-ARIA disclosure pattern
  function closeAllDropdowns(except?: Element) {
    document.querySelectorAll<HTMLElement>('.has-dropdown').forEach((item) => {
      if (item === except) return;
      item.removeAttribute('data-open');
      const btn = item.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
      if (btn) btn.setAttribute('aria-expanded', 'false');
    });
  }

  document.querySelectorAll<HTMLElement>('.has-dropdown').forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    const menu = item.querySelector<HTMLElement>('[data-dropdown-menu]');
    if (!toggle || !menu) return;

    const menuLinks = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = item.getAttribute('data-open') === 'true';
      closeAllDropdowns(item);
      if (!isOpen) {
        item.setAttribute('data-open', 'true');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });

    // Arrow keys to navigate into/within dropdown
    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        item.setAttribute('data-open', 'true');
        toggle.setAttribute('aria-expanded', 'true');
        menuLinks[0]?.focus();
      }
      if (e.key === 'Escape') {
        closeAllDropdowns();
        toggle.focus();
      }
    });

    menuLinks.forEach((link, i) => {
      link.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); menuLinks[i + 1]?.focus(); }
        if (e.key === 'ArrowUp')   { e.preventDefault(); i === 0 ? toggle.focus() : menuLinks[i - 1]?.focus(); }
        if (e.key === 'Escape')    { closeAllDropdowns(); toggle.focus(); }
        if (e.key === 'Tab' && i === menuLinks.length - 1 && !e.shiftKey) {
          // Tab past the last item closes the dropdown
          closeAllDropdowns();
        }
      });
    });
  });

  // Click outside closes all dropdowns
  document.addEventListener('click', () => closeAllDropdowns());
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAllDropdowns(); });
</script>
