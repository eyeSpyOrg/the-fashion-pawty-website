---
/**
 * Accessible FAQ accordion (native <details>/<summary> — zero JS,
 * keyboard-operable by default) + FAQPage schema for AEO.
 * The visible content and the schema are generated from the SAME
 * array, so they can never drift apart (Google requirement).
 *
 * Usage:
 *   <FAQ faqs={[{ question: '...', answer: '...' }]} />
 * `answer` is usually plain text, but may also be an array mixing
 * strings with { text, href, external? } link parts for an inline
 * link mid-answer. FAQSchema always gets the plain-text-only version
 * (its documented contract — see FAQSchema.astro).
 */
import FAQSchema from './schema/FAQSchema.astro';

interface LinkPart { text: string; href: string; external?: boolean }
type Answer = string | (string | LinkPart)[];
interface Item { question: string; answer: Answer }
interface Props { faqs: Item[]; heading?: string }
const { faqs, heading = 'Frequently asked questions' } = Astro.props;

const plainText = (answer: Answer) =>
  Array.isArray(answer) ? answer.map((p) => (typeof p === 'string' ? p : p.text)).join('') : answer;
---

<section class="faq" aria-labelledby="faq-heading">
  <h2 id="faq-heading">{heading}</h2>
  {faqs.map((f) => (
    <details class="faq__item">
      <summary>{f.question}</summary>
      <p>
        {Array.isArray(f.answer)
          ? f.answer.map((part) =>
              typeof part === 'string' ? part : (
                <a href={part.href} target={part.external ? '_blank' : undefined} rel={part.external ? 'noopener' : undefined}>
                  {part.text}
                </a>
              )
            )
          : f.answer}
      </p>
    </details>
  ))}
</section>
<FAQSchema faqs={faqs.map((f) => ({ question: f.question, answer: plainText(f.answer) }))} />

<style>
  .faq h2 { margin: 0 0 var(--space-m); }
  .faq__item {
    border: 2px solid var(--color-border);
    border-radius: 10px;
    margin-bottom: 0.75rem;
    background: var(--color-bg);
  }
  .faq__item summary {
    padding: 1rem 1.25rem;
    font-weight: 700;
    cursor: pointer;
    min-height: 44px;
  }
  .faq__item summary:hover { background: var(--color-surface); }
  .faq__item p { padding: 0 1.25rem 1rem; margin: 0; max-width: 70ch; }
</style>
