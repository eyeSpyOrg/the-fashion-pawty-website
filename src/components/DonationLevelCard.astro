---
/**
 * DonationLevelCard.astro — one pooled-fund level on /donate or /pawtners.
 * Deliberately mirrors SponsorCard.astro's layout (image left → title →
 * short description → bullet list → price/CTA) since these pages reuse
 * the existing sponsorship-tier component pattern. No org name appears
 * here — that only shows up once, in the pool-framing line above the list.
 */
interface Props {
  title: string;
  description: string;
  bullets: string[];
  priceLabel: string;
  buttonText: string;
  stripeUrl: string;
  imageAlt: string;
}
const {
  title,
  description,
  bullets,
  priceLabel,
  buttonText,
  stripeUrl,
  imageAlt,
} = Astro.props;
---

<li class="level-card">
  <div class="level-card__header">
    <div class="level-card__image">
      <img
        src="/images/sponsors/sponsor-placeholder.webp"
        alt={imageAlt}
        width="1000"
        height="1000"
        loading="lazy"
      />
    </div>
    <div class="level-card__intro">
      <h3 class="level-card__title">{title}</h3>
      <p class="level-card__copy">{description}</p>
    </div>
  </div>

  <div class="level-card__body">
    <ul class="level-card__bullets">
      {bullets.map((b) => <li>{b}</li>)}
    </ul>

    <div class="level-card__action">
      <p class="level-card__price">{priceLabel}</p>
      <a class="btn btn--primary" href={stripeUrl} target="_blank" rel="noopener">
        {buttonText}
      </a>
    </div>
  </div>
</li>

<style>
  .level-card {
    background: var(--color-surface);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .level-card:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
  html[data-a11y-motion='off'] .level-card:hover { transform: none; }
  @media (prefers-reduced-motion: reduce) { .level-card:hover { transform: none; } }

  .level-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  @media (min-width: 40rem) {
    .level-card__header { flex-direction: row; align-items: center; }
  }

  .level-card__image {
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  @media (min-width: 40rem) {
    .level-card__image { width: 5.5rem; }
  }
  .level-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .level-card__intro {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .level-card__title {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
  }

  .level-card__copy {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .level-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border-hairline);
  }
  @media (min-width: 40rem) {
    .level-card__body { flex-direction: row; align-items: flex-start; justify-content: space-between; }
  }

  .level-card__bullets {
    flex: 1;
    min-width: 0;
    width: 100%;
    list-style: disc;
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  @media (min-width: 40rem) {
    .level-card__bullets { width: auto; }
  }

  .level-card__action {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    width: 100%;
  }
  @media (min-width: 40rem) {
    .level-card__action { width: auto; min-width: 11rem; }
  }

  .level-card__price {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--color-accent);
  }

  .level-card__action .btn { width: 100%; }
  @media (min-width: 40rem) {
    .level-card__action .btn { width: auto; }
  }
</style>
