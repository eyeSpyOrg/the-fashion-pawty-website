---
/**
 * ShareSection.astro — "Share the PAWty" block, identical on both pages.
 * Three share intents only (SMS, email, Facebook) — plain links, no
 * backend. The Facebook quote is prefilled with on-brand copy naming both
 * beneficiaries; Eye Spy is @-tagged with its verified handle (SITE.socials).
 * No verified Leader Dogs for the Blind social handle exists in site.js,
 * so it's named in full rather than guessed at.
 */
import { SITE } from '../config/site.js';

const shareUrl = new URL(Astro.url.pathname, SITE.url).href;
const shareText = 'Join me at The Fashion PAWty — help support the blind and low vision community and Leader Dogs for the Blind.';

const eyeSpyFacebookUrl = SITE.socials.find((s) => s.icon === 'facebook')?.url;
const eyeSpyFacebookHandle = eyeSpyFacebookUrl ? new URL(eyeSpyFacebookUrl).pathname.replace(/\//g, '') : 'eyespyorg';
const fbShareText = `I just supported The Fashion PAWty 🐾 — a doggie fashion show benefiting @${eyeSpyFacebookHandle} and Leader Dogs for the Blind, helping the blind and low vision community navigate the world with more confidence.`;

const smsHref = `sms:?&body=${encodeURIComponent(`${shareText} ${shareUrl}`)}`;
const emailHref = `mailto:?subject=${encodeURIComponent('Join me at The Fashion PAWty')}&body=${encodeURIComponent(`${shareText}\n\n${shareUrl}`)}`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}&quote=${encodeURIComponent(fbShareText)}`;
---

<section class="band" aria-labelledby="share-h">
  <div class="container container--narrow">
    <div class="section-head section-head--center">
      <p class="eyebrow">Spread the Word</p>
      <h2 id="share-h">Share the PAWty</h2>
      <p class="prose mx-auto">Know someone who'd love this? Pass it on.</p>
    </div>

    <div class="share-actions">
      <a class="btn btn--secondary" href={emailHref}>Email a Friend</a>
      <a class="btn btn--secondary" href={smsHref}>Text Someone</a>
      <a class="btn btn--secondary" href={facebookHref} target="_blank" rel="noopener">Post on Facebook</a>
    </div>
  </div>
</section>

<style>
  .share-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }
</style>
