---
/**
 * Event schema for The Fashion PAWty. Facts come from SITE.event and
 * SITE.address (single source — BRAND.md § 2.7), so the schema can never
 * drift from the visible dates, venue, and price.
 * Used on: /, /tickets/, /schedule/, /venue/.
 *
 * `sponsors` is optional — pass matching records from src/data/partners.js
 * (homepage only, per BRAND.md's single-source discipline) to add
 * schema.org `sponsor` entries without hand-typing name/url twice.
 */
import { SITE } from '../../config/site.js';
import JsonLd from './JsonLd.astro';

interface Props {
  sponsors?: { name: string; website: string }[];
}
const { sponsors = [] } = Astro.props;

const e = SITE.event;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.name,
  description: e.description,
  startDate: e.startDate,
  endDate: e.endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: e.venueName,
    address: {
      '@type': 'PostalAddress',
      ...SITE.address,
    },
  },
  image: [new URL(SITE.ogImage, SITE.url).href],
  performer: {
    '@type': 'PerformingGroup',
    name: 'The Fashion PAWty Runway Show',
  },
  offers: {
    '@type': 'Offer',
    name: 'PAWty Pass',
    price: e.ticketPrice,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: e.ticketUrl,
    validFrom: '2026-08-01T00:00:00-04:00',
  },
  organizer: {
    '@type': 'Organization',
    name: SITE.legalName,
    url: SITE.url,
  },
  ...(sponsors.length > 0 && {
    sponsor: sponsors.map((s) => ({
      '@type': 'Organization',
      name: s.name,
      url: s.website,
    })),
  }),
};
---
<JsonLd schema={schema} />
