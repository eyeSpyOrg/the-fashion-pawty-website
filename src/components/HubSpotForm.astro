---
/**
 * HubSpotForm.astro — accessible native form → HubSpot Forms
 * Submission API (no embed widget, no secret, works on static hosting).
 *
 * Usage:
 *   <HubSpotForm
 *     formGuid="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
 *     heading="Stay in the loop"
 *     fields={[
 *       { name: 'firstname', label: 'First name', type: 'text', required: true },
 *       { name: 'email', label: 'Email address', type: 'email', required: true },
 *     ]}
 *   />
 * Field `name` must equal the HubSpot property internal name.
 * Portal ID comes from site.js → integrations.hubspotPortalId.
 */
import { SITE } from '../config/site.js';

interface Field {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'url' | 'textarea' | 'checkbox' | 'select' | 'divider';
  required?: boolean;
  autocomplete?: string;
  options?: { value: string; label: string }[];  // for select
  placeholder?: string;
}
interface Props {
  formGuid: string;
  heading?: string;
  fields: Field[];
  submitLabel?: string;
}
const { formGuid, heading = 'Contact us', fields, submitLabel = 'Send' } = Astro.props;
const portalId = SITE.integrations?.hubspotPortalId ?? '';
const formId = `hsf-${formGuid.slice(0, 8)}`;
---

<form
  class="hs-form"
  data-hs-form
  data-portal={portalId}
  data-guid={formGuid}
  novalidate
  aria-labelledby={`${formId}-heading`}
>
  <h2 id={`${formId}-heading`}>{heading}</h2>

  <!-- Announced to screen readers on success/failure -->
  <p class="hs-form__status" role="status" aria-live="polite" data-hs-status tabindex="-1"></p>

  {fields.map((f) => {
    if (f.type === 'divider') {
      return <p class="hs-form__divider" role="presentation">{f.label}</p>;
    }
    const id = `${formId}-${f.name}`;
    const errId = `${id}-error`;
    if (f.type === 'checkbox') {
      return (
        <div class="hs-form__field hs-form__field--check">
          <input
            id={id}
            name={f.name}
            type="checkbox"
            required={f.required}
            value="true"
            aria-describedby={errId}
          />
          <label for={id}>
            {f.label}{f.required && <span aria-hidden="true"> *</span>}
            {f.required && <span class="sr-only"> (required)</span>}
          </label>
          <p class="field-error" id={errId} data-error-for={f.name} hidden></p>
        </div>
      );
    }
    return (
      <div class="hs-form__field">
        <label for={id}>
          {f.label}{f.required && <span aria-hidden="true"> *</span>}
          {f.required && <span class="sr-only"> (required)</span>}
        </label>
        {f.type === 'textarea' ? (
          <textarea
            id={id}
            name={f.name}
            rows="4"
            required={f.required}
            aria-describedby={errId}
            placeholder={f.placeholder}
          />
        ) : f.type === 'select' ? (
          <select
            id={id}
            name={f.name}
            required={f.required}
            aria-describedby={errId}
          >
            <option value="">Select one…</option>
            {f.options?.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        ) : (
          <input
            id={id}
            name={f.name}
            type={f.type ?? 'text'}
            required={f.required}
            autocomplete={f.autocomplete ?? (f.type === 'email' ? 'email' : undefined)}
            aria-describedby={errId}
            placeholder={f.placeholder}
          />
        )}
        <p class="field-error" id={errId} data-error-for={f.name} hidden></p>
      </div>
    );
  })}

  <button type="submit" class="hs-form__submit">{submitLabel}</button>
</form>

<style>
  .hs-form { max-width: 32rem; }
  .hs-form__field { margin-bottom: 1.25rem; }
  .hs-form__field--check {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .hs-form__field--check input[type="checkbox"] {
    margin-top: 0.2rem;
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    cursor: pointer;
  }
  .hs-form__field--check label { cursor: pointer; }
  .hs-form__divider {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    margin: 1.5rem 0 1.25rem;
    padding-top: 1.25rem;
  }
  select {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--step-0);
    cursor: pointer;
  }
  select:focus { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .hs-form__submit {
    background: var(--color-accent);
    color: #ffffff;
    border: 2px solid var(--color-accent);
    border-radius: 10px;
    padding: 0.75rem 1.75rem;
    font-weight: 700;
  }
  .hs-form__submit:hover { background: var(--color-accent-hover); }
  :global(html[data-a11y-contrast='high']) .hs-form__submit { color: #000000; }
  .hs-form__status:empty { display: none; }
  .hs-form__status {
    font-weight: 600;
    margin: 0 0 1rem;
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hs-form__status:focus { outline: none; } /* tabindex="-1" — programmatic focus only, not in tab order */
  .hs-form__status:not(:empty) {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border: 2px solid var(--color-accent);
  }
  .hs-form__status[data-error='true'] {
    background: color-mix(in srgb, #dc2626 10%, transparent);
    border-color: #dc2626;
    color: #991b1b;
  }
  .hs-status__icon { font-size: 1.5rem; }

  /* Hide form fields after successful submission */
  .hs-form[data-submitted='true'] .hs-form__field,
  .hs-form[data-submitted='true'] .hs-form__field--check,
  .hs-form[data-submitted='true'] .hs-form__divider,
  .hs-form[data-submitted='true'] .hs-form__submit { display: none; }
</style>

<script>
  function getCookie(name: string): string {
    const m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
    return m ? decodeURIComponent(m[1]) : '';
  }

  document.querySelectorAll<HTMLFormElement>('[data-hs-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-hs-status]')!;
    let submitting = false;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Prevent duplicate submissions while in flight or already completed
      if (submitting || form.hasAttribute('data-submitted')) return;
      submitting = true;

      // Auto-prepend https:// to URL fields so bare "website.com" values pass validation
      form.querySelectorAll<HTMLInputElement>('input[type="url"]').forEach((input) => {
        const v = input.value.trim();
        if (v && !/^https?:\/\//i.test(v)) {
          input.value = 'https://' + v;
        }
      });

      // Client validation with accessible errors
      let firstInvalid: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select').forEach((input) => {
        const err = form.querySelector<HTMLElement>(`[data-error-for="${input.name}"]`);
        if (!err) return;
        if (!input.checkValidity()) {
          input.setAttribute('aria-invalid', 'true');
          err.textContent = input.validity.valueMissing
            ? ((input as HTMLInputElement).type === 'checkbox' ? 'You must agree to continue.' : 'This field is required.')
            : 'Please enter a valid ' + (input.type === 'email' ? 'email address.' : 'value.');
          err.hidden = false;
          firstInvalid ??= input;
        } else {
          input.removeAttribute('aria-invalid');
          err.hidden = true;
        }
      });
      if (firstInvalid) { firstInvalid.focus(); return; }

      const portalId = form.dataset.portal;
      const formGuid = form.dataset.guid;
      const payload = {
        fields: Array.from(new FormData(form).entries()).map(([name, value]) => ({
          name,
          value: String(value),
        })),
        context: {
          hutk: getCookie('hubspotutk') || undefined,
          pageUri: location.href,
          pageName: document.title,
        },
      };

      const submitBtn = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';

      try {
        const res = await fetch(
          `https://api.hsforms.com/submissions/v3/integration/submit/${portalId}/${formGuid}`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          }
        );
        if (!res.ok) throw new Error(String(res.status));

        // Hide all fields and the submit button, show full thank-you state
        form.setAttribute('data-submitted', 'true');
        status.innerHTML = `
          <span class="hs-status__icon" aria-hidden="true">🐾</span>
          <strong>Application received — thank you!</strong>
          <span>We'll review your submission and be in touch soon. Keep an eye on <em>${
            Array.from(new FormData(form).entries()).find(([n]) => n === 'email')?.[1] ?? 'your inbox'
          }</em> for next steps.</span>
        `;
        status.scrollIntoView({ behavior: 'smooth', block: 'center' });
        status.focus();

        // Forward to GA4 if loaded
        (window as any).gtag?.('event', 'form_submit', { form_guid: formGuid });
      } catch {
        status.textContent =
          'Something went wrong sending your application. Please try again or email us directly.';
        status.setAttribute('data-error', 'true');
        status.scrollIntoView({ behavior: 'smooth', block: 'center' });
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit';
        submitting = false;
      }
    });
  });
</script>
