---
/**
 * Tickets — $30 PAWty Pass. Copy adapted from user brief 2026-08-31;
 * Event schema. "Can't make it?" strip reuses the $20/$60/$90 donation
 * tiers from src/data/donationTiers.js so amounts never drift from /donate.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EventSchema from '../components/schema/EventSchema.astro';
import FAQ from '../components/FAQ.astro';
import { SITE } from '../config/site.js';
import { levels } from '../data/donationTiers.js';

const benefits = [
  'Admission to the show',
  'Take-home doggie tote bag',
  'Food, Live Music, MockTAILS',
  'Family Fun and Kids Under 12 admitted for free',
];

const findLevel = (id) => levels.find((l) => l.id === id);
const giveCards = [
  {
    ...findLevel('puppy-pawty'),
    title: 'Give a Toy & a Treat',
    blurb: 'A treat and a toy go a long way for a future guide dog puppy in training.',
    cta: 'Throw a Puppy PAWty',
    image: '/images/tickets/toy-and-treat.webp',
    imageAlt: 'A future Leader Dog puppy in training wearing a "Future Leader Dog" bandana',
  },
  {
    ...findLevel('pawty-pass-pair'),
    title: 'PASS It Forward',
    blurb: 'Purchase a PAWty Pass for a blind or low-vision community member.',
    cta: 'Give a PAWty Pass',
    image: '/images/tickets/pawty-pass.webp',
    imageAlt: 'The Fashion PAWty logo on a PAWty Pass donation card',
  },
  {
    ...findLevel('navigator-support'),
    title: 'Help Us Navigate',
    blurb: 'Give a one-on-one Eye Spy Navigator session to help create independence.',
    cta: 'Support the Community',
    image: '/images/tickets/navigator-support.webp',
    imageAlt: 'A man wearing headphones works at a desk with a white cane resting nearby',
  },
];

const faqs = [
  {
    question: 'What is The Fashion PAWty?',
    answer: [
      'It’s a doggie fashion show and community celebration — "A Navigation Celebration" — hosted by the Eye Spy Foundation. Dogs strut the orange carpet while the community enjoys mocktails, food, games, and music, all to support ',
      { text: 'the blind and low vision community and Leader Dogs for the Blind', href: '/beneficiaries/' },
      '.',
    ],
  },
  {
    question: 'When and where is it?',
    answer: [
      'Saturday, September 26, 2026, from 4 to 7 PM at ',
      { text: 'Happy Brew', href: '/venue/' },
      ', 3200 Hendricks Ave, Jacksonville, FL 32207.',
    ],
  },
  {
    question: "How much are tickets and what's included?",
    answer: [
      'Tickets are $30 and include general admission, a take-home tote, food, unlimited mocktails, and live music. ',
      { text: 'Get Your PAWty Pass', href: SITE.event.ticketUrl, external: true },
    ],
  },
  {
    question: 'Who does the event benefit?',
    answer: [
      { text: 'The Eye Spy Foundation and Leader Dogs for the Blind', href: '/beneficiaries/' },
      '. Eye Spy is also sponsoring one Leader Dogs puppy this year.',
    ],
  },
  {
    question: 'Can I bring my dog?',
    answer:
      'To ensure a safe and enjoyable event for everyone, only dogs participating in the fashion show may attend. We love all pups, but space and safety considerations require us to limit attendance to registered runway participants.',
  },
  {
    question: 'Is the event accessible?',
    answer: [
      'Yes — the entire ',
      { text: 'venue', href: '/venue/' },
      ' is accessible, and ',
      { text: 'accessibility', href: '/accessibility/' },
      ' is at the heart of everything we do. Questions about your visit? Email ',
      { text: SITE.email, href: `mailto:${SITE.email}` },
      " and we'll help.",
    ],
  },
  {
    question: "I can't make it — can I still help?",
    answer:
      'Absolutely. Scroll down to the "Can\'t make it?" section below for three easy ways to support the cause from anywhere.',
  },
];
---

<BaseLayout
  title="Tickets — $30 PAWty Pass"
  description="Fashion PAWty tickets are $30 and include the doggie fashion show, food, and mocktails on Sep 26 at Happy Brew, Jacksonville — supporting the blind and low vision community."
>
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">About Getting Tickets</p>
          <h1>Get Your Tickets</h1>
          <p class="prose lead">
            The first annual Fashion PAWty is hosted by the Eye Spy
            Foundation, celebrating dogs, community, and purpose. Proceeds
            support Eye Spy Foundation and Leader Dogs for the Blind, helping
            blind and low-vision individuals navigate the world with
            confidence.
          </p>
        </div>
        <div class="panel ticket-card ticket-card--hero">
          <p class="eyebrow">PAWty Pass</p>
          <p class="ticket-card__price"><span class="ticket-card__amt">$30</span></p>
          <h2 class="ticket-card__h">Benefits</h2>
          <ul class="ticket-list">
            {benefits.map((b) => <li>{b}</li>)}
          </ul>
          <a class="btn btn--primary btn--lg ticket-card__cta" href={SITE.event.ticketUrl} target="_blank" rel="noopener">
            Join the PAWty
          </a>
          <p class="ticket-card__note">
            Processed securely through the Eye Spy Foundation's Stripe
            account. Proceeds support the blind and low vision community and
            Leader Dogs for the Blind.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--gold" aria-labelledby="cant-make-it-h">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        <p class="eyebrow">Support From Anywhere</p>
        <h2 id="cant-make-it-h">Can't Make It? Out of Towner?</h2>
        <p class="prose mx-auto">
          Don't worry — you can still support the cause! Pick a way to give
          below.
        </p>
      </div>

      <ul class="grid grid--3 give-grid">
        {giveCards.map((g) => (
          <li class="card card--accent give-card">
            <img
              class="give-card__photo"
              src={g.image}
              alt={g.imageAlt}
              width="1000"
              height="1000"
              loading="lazy"
            />
            <div class="give-card__body">
              <h3>{g.title}</h3>
              <p>{g.blurb}</p>
              <a class="btn btn--primary give-card__cta" href="/donate/">
                {g.cta}
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="container container--narrow">
      <FAQ faqs={faqs} heading="PAWty questions, answered" />
    </div>
  </section>

  <EventSchema />
</BaseLayout>

<style>
  .lead { font-size: var(--step-1); color: var(--color-text-muted); }

  .split { display: grid; gap: var(--space-l); align-items: flex-start; }
  .split__text > * + * { margin-top: var(--space-s); }
  @media (min-width: 52rem) {
    .split { grid-template-columns: 1fr 1fr; gap: var(--space-xl); }
  }
  h1 { text-wrap: balance; }

  .ticket-card { max-width: 32rem; padding: clamp(1.25rem, 1rem + 1.5vw, 2rem); }
  .ticket-card > * + * { margin-top: var(--space-s); }
  .ticket-card__price { margin: 0; }
  .ticket-card__amt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 1.5rem + 5vw, 3.5rem);
    color: var(--color-accent);
    line-height: 1;
  }
  .ticket-card__h { margin-top: var(--space-s); }
  .ticket-list { margin: 0; padding-left: 1.25rem; list-style: disc; }
  .ticket-list li { margin-bottom: 0.4rem; }
  .ticket-card__cta { width: 100%; margin-top: var(--space-s); }
  .ticket-card__note { font-size: 0.85rem; color: var(--color-text-muted); }

  .give-grid { list-style: none; margin: var(--space-l) 0 0; padding: 0; }
  .give-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .give-card__photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }
  .give-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-m);
    flex: 1;
  }
  .give-card__body h3 { margin: 0; }
  .give-card__body p { margin: 0; flex: 1; }
  .give-card__cta { margin-top: var(--space-2xs); width: 100%; }
</style>
