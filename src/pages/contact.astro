---
/**
 * Contact — NAP renders only from site.js (never drifts from footer
 * or Organization schema). Inquiry form posts to HubSpot via
 * HubSpotForm.astro's native form + Forms Submission API — never the
 * embedded widget script (see CLAUDE.md § Phase 2 integrations).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubSpotForm from '../components/HubSpotForm.astro';
import { SITE } from '../config/site.js';

// Non-breaking space + hyphen (U+00A0 / U+2011) so the number never wraps
const telDisplay = '(844) 222‑8848';
---

<BaseLayout
  title="Contact"
  description="Contact The Fashion PAWty team at team@eyespy.org or (844) 222-8848 with questions about tickets, sponsorship, or accessibility — we greet everyone with a hug or a handshake."
>
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">About Getting Help</p>
          <h1>Say Hello</h1>
          <p class="prose lead">
            We greet everyone with a hug or a handshake — and email works too.
            Have a question about tickets, sponsorship, or how the Eye Spy
            Foundation supports the blind and low vision community?
          </p>
        </div>
        <img
          class="hero-photo"
          src="/images/contact/lets-pawty.webp"
          alt="'Let's PAWty' graphic on a pattern of palm trees, sunglasses, bow ties, and paw prints"
          width="1600"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container container--narrow">
      <h2 class="sr-only">Ways to reach us</h2>
      <div class="grid grid--2">
        <a class="card card--accent card--link contact-card" href={`mailto:${SITE.email}`}>
          <span class="contact-card__icon" aria-hidden="true">✉️</span>
          <span class="contact-card__label">Email</span>
          <span class="contact-card__value">{SITE.email}</span>
        </a>
        <a class="card card--accent card--link contact-card" href={`tel:${SITE.telephone}`}>
          <span class="contact-card__icon" aria-hidden="true">📞</span>
          <span class="contact-card__label">Phone</span>
          <span class="contact-card__value">{telDisplay}</span>
        </a>
      </div>

      <div class="card find-us">
        <h3 class="find-us__h">Where is the PAWty?</h3>
        <p>
          {SITE.event.venueName}, {SITE.address.streetAddress},
          {SITE.address.addressLocality}, {SITE.address.addressRegion}
          {SITE.address.postalCode} — see the <a href="/venue/">Venue page</a>
          for parking and accessibility details.
        </p>
      </div>

      <div class="contact-form">
        <p class="eyebrow">Have a Question?</p>
        <HubSpotForm
          formGuid="887b5e29-d7e8-41a0-8c30-cd7928ce81cc"
          heading="Send Us a Message"
          submitLabel="Send Message"
          fields={[
            { name: 'firstname', label: 'Name', type: 'text', required: true, autocomplete: 'name' },
            { name: 'email', label: 'Email address', type: 'email', required: true },
            { name: 'message', label: 'Message', type: 'textarea', required: true },
          ]}
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead { font-size: var(--step-1); color: var(--color-text-muted); }
  .contact-card {
    display: grid; gap: 0.35rem; text-decoration: none; color: var(--color-text);
  }
  .contact-card__icon { font-size: 2rem; line-height: 1; }
  .contact-card__label {
    font-family: var(--font-display); font-weight: 700; font-size: 0.8rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent);
  }
  .contact-card__value { font-size: var(--step-1); font-weight: 700; word-break: break-word; }
  .find-us { margin-top: var(--space-m); }
  .find-us__h { margin: 0 0 0.35rem; }

  /* Same card language as the footer newsletter strip (teal-tint,
     radius-lg, shadow-sm) so the two HubSpot-powered forms on the site
     read as one consistent pattern rather than two different styles. */
  .contact-form {
    margin-top: var(--space-m);
    padding: var(--space-l);
    background: var(--color-teal-tint);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .contact-form :global(.hs-form) { max-width: none; }
  .contact-form :global(.hs-form h2) { margin-top: 0; }
  html[data-a11y-contrast='high'] .contact-form { background: var(--color-surface); }

  .lead { font-size: var(--step-1); color: var(--color-text-muted); }
  .split { display: grid; gap: var(--space-l); align-items: center; }
  .split__text > * + * { margin-top: var(--space-s); }
  @media (min-width: 52rem) {
    .split { grid-template-columns: 1.5fr 1fr; gap: var(--space-xl); }
  }
  h1 { text-wrap: balance; }

  .hero-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
</style>
