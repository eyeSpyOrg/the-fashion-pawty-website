---
/**
 * /gallery/ — Gallery hub page.
 * Lists all annual photo galleries for The Fashion PAWty.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site.js';
---

<BaseLayout
  title="Photo Gallery"
  description="Browse photos from every Fashion PAWty — Jacksonville's dog fashion show benefiting the Eye Spy Foundation and Leader Dogs for the Blind. View the 2026 gallery."
>
  <section class="band band--teal band--tight">
    <div class="container">
      <p class="eyebrow">{SITE.name}</p>
      <h1>Event Photo Gallery</h1>
      <p class="lead">Relive the PAWty — every year, one runway at a time.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="gallery-hub-h">
    <div class="container">
      <h2 id="gallery-hub-h" class="sr-only">All galleries</h2>
      <ul class="gallery-hub" role="list">
        <li>
          <a href="/gallery/2026/" class="gallery-hub__card card">
            <div class="gallery-hub__card-year">2026</div>
            <div class="gallery-hub__card-body">
              <h3 class="gallery-hub__card-title">The Fashion PAWty 2026</h3>
              <p class="gallery-hub__card-meta">September 26 · Happy Brew, Jacksonville, FL</p>
              <p class="gallery-hub__card-desc">
                "A Navigation Celebration" — the runway, the crowd, live music,
                and the dogs who stole the show.
              </p>
              <span class="gallery-hub__card-cta btn btn--primary">View Gallery →</span>
            </div>
            <div class="gallery-hub__card-img" aria-hidden="true">
              <img
                src="/images/gallery/2026/runway-white-pomeranian-pose.webp"
                alt=""
                width="1080"
                height="1080"
                loading="lazy"
                decoding="async"
              />
            </div>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-hub { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-m); }

  .gallery-hub__card {
    display: grid;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s;
    grid-template-columns: 6rem 1fr;
    grid-template-rows: auto;
  }
  @media (min-width: 48rem) {
    .gallery-hub__card { grid-template-columns: 6rem 1fr 220px; }
  }

  .gallery-hub__card:hover,
  .gallery-hub__card:focus-visible { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .gallery-hub__card:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }

  .gallery-hub__card-year {
    display: flex; align-items: center; justify-content: center;
    background: var(--color-accent); color: #fff;
    font-family: var(--font-display); font-size: var(--step-2); font-weight: 700;
    border-radius: var(--radius) 0 0 0;
    padding: var(--space-s); min-height: 7rem;
  }
  @media (max-width: 47.99rem) {
    .gallery-hub__card-year { border-radius: var(--radius) var(--radius) 0 0; grid-column: 1 / -1; min-height: 3.5rem; }
    .gallery-hub__card { grid-template-columns: 1fr; }
  }

  .gallery-hub__card-body {
    padding: var(--space-m); display: flex; flex-direction: column; gap: var(--space-xs);
  }
  .gallery-hub__card-title { margin: 0; font-size: var(--step-1); }
  .gallery-hub__card-meta { margin: 0; color: var(--color-text-muted); font-size: 0.9rem; }
  .gallery-hub__card-desc { margin: 0; }
  .gallery-hub__card-cta { align-self: flex-start; margin-top: auto; padding-top: var(--space-xs); }

  .gallery-hub__card-img {
    display: none;
    overflow: hidden;
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  @media (min-width: 48rem) { .gallery-hub__card-img { display: block; } }
  .gallery-hub__card-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .gallery-hub__card:hover .gallery-hub__card-img img { transform: scale(1.04); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
</style>
