---

<BaseLayout
  title="Sponsor the PAWty"
  description="Sponsor The Fashion PAWty, hosted by Eye Spy Foundation — packages from $75–$5,000 supporting the blind and low vision community and Leader Dogs for the Blind."
>
  <!-- ══ INTRO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">About Sponsorship</p>
          <h1>Sponsor the PAWty</h1>
          <p class="prose lead">
            Every sponsorship helps fund The Fashion PAWty and supports the Eye
            Spy Foundation's mission to create a more accessible world for the
            blind and low vision community. Pick your package, put your brand at
            the center of the orange carpet, and help us reach our $25,000 goal.
          </p>
        </div>
        <img
          class="hero-photo"
          src="/images/sponsors/sponsorship-hero.webp"
          alt="The Fashion PAWty — A Navigation Celebration! Presented by: your company logo here"
          width="1600"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══ WHY SPONSOR (AEO) ══ -->
  <section class="band band--tight">
    <div class="container container--narrow why-sponsor">
      <h2>Why Sponsor The Fashion PAWty?</h2>
      <p class="prose">
        Sponsorship dollars fund the Eye Spy Foundation and Leader Dogs for
        the Blind, helping the blind and low vision community navigate the
        world with more confidence — while putting your brand in front of
        an engaged Jacksonville audience.
      </p>
      <a class="btn btn--secondary" href="/beneficiaries/">View Our Beneficiaries</a>
      <div class="logo-row">
        <img
          src="/images/sponsors/eyespy-logo-card.webp"
          alt="Eye Spy Foundation logo"
          width="1600"
          height="1200"
          loading="lazy"
        />
        <img
          src="/images/sponsors/leaderdogs-logo-card.webp"
          alt="Leader Dogs for the Blind logo"
          width="1600"
          height="1200"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ══ 1. MAIN SPONSOR ══ -->
  <section class="band" aria-labelledby="main-sponsor-h">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        <p class="eyebrow">Presenting Sponsor</p>
        <h2 id="main-sponsor-h">Main Sponsor</h2>
      </div>

      <ul class="tier-grid">
        {mainSponsor.map((tier) => <SponsorCard {...tier} />)}
      </ul>
    </div>
  </section>

  <!-- ══ 2. TOP DOG SPONSORSHIPS ══ -->
  <section class="band band--teal" aria-labelledby="top-dog-h">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        <p class="eyebrow">Signature Zones</p>
        <h2 id="top-dog-h">Top Dog Sponsorships</h2>
        <p class="prose">
          Claim naming rights over one of our three signature zones. Every
          package includes runway recognition, social shout-outs, and food
          and mocktails for two.
        </p>
      </div>

      <ul class="tier-grid">
        {topDog.map((tier) => <SponsorCard {...tier} />)}
      </ul>
    </div>
  </section>

  <!-- ══ 3. PAWTY ANIMAL SPONSORSHIPS ══ -->
  <section class="band" aria-labelledby="pawty-animal-h">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        <p class="eyebrow">Activity Zones</p>
        <h2 id="pawty-animal-h">PAWty Animal Sponsorships</h2>
        <p class="prose">
          Put your brand at the center of a hands-on guest activity. Every
          package includes social shout-outs plus PAWty Passes with food and
          mocktails included.
        </p>
      </div>

      <ul class="tier-grid">
        {pawtyAnimal.map((tier) => <SponsorCard {...tier} />)}
      </ul>
    </div>
  </section>

  <SponsorshipSchema tiers={allTiers} url="/sponsor/" />
</BaseLayout>

<style>
  .lead { font-size: var(--step-1); color: var(--color-text-muted); }

  .split { display: grid; gap: var(--space-l); align-items: center; }
  .split__text > * + * { margin-top: var(--space-s); }
  @media (min-width: 52rem) {
    .split { grid-template-columns: 1.5fr 1fr; gap: var(--space-xl); }
  }

  .hero-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  h1 { text-wrap: balance; }

  .section-head--center .prose { margin-top: var(--space-xs); }

  /* "Why Sponsor" section — one column: heading, copy, button, then the
     two logo cards side by side below (Eye Spy left, Leader Dogs right). */
  .why-sponsor > .btn { display: inline-flex; margin-top: var(--space-m); }
  .logo-row {
    display: flex;
    gap: var(--space-m);
    margin-top: var(--space-m);
  }
  @media (max-width: 34rem) {
    .logo-row { flex-direction: column; }
  }
  .logo-row > img {
    flex: 1;
    min-width: 0;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    border-radius: var(--radius);
  }

  /* ── Tier list — one column, stacked, full width of its (narrow)
     container — same container--narrow convention used sitewide for
     single-column content, instead of a one-off percentage. ── */
  .tier-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
