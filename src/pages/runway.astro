---
/**
 * Runway — registration page for dog owners entering the fashion show.
 * TODO: Replace formGuid with the real HubSpot Runway Registration form GUID.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubSpotForm from '../components/HubSpotForm.astro';
import { SITE } from '../config/site.js';
---

<BaseLayout
  title="Enter the Runway — Dog Fashion Show"
  description="Think your dog has what it takes? Enter them in The Fashion PAWty dog fashion show on September 26 at Happy Brew, Jacksonville. Register your pup for the orange carpet today."
>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">The Dog Fashion Show</p>
          <h1>Your Dog Was Born for This.</h1>
          <p class="prose lead">
            The orange carpet is calling. Register your pup to strut the runway
            at The Fashion PAWty — Jacksonville's most stylish evening of the year.
            Judges. Cheers. Bragging rights. Best in Show.
          </p>
          <a class="btn btn--primary btn--lg" href="#runway-form">Register Your Dog</a>
        </div>
        <img
          class="hero-photo"
          src="/images/contact/lets-pawty.webp"
          alt="Festive paw print and fashion-themed graphic representing the Fashion PAWty runway"
          width="1600"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══ SHOW TIMELINE ══ -->
  <section class="band" aria-labelledby="timeline-h">
    <div class="container container--narrow">
      <div class="section-head">
        <p class="eyebrow">Show Schedule</p>
        <h2 id="timeline-h">What Happens on Show Night</h2>
      </div>
      <ol class="timeline" aria-label="Runway show timeline">
        <li class="timeline-item">
          <span class="timeline-time">5:00 PM</span>
          <div class="timeline-content">
            <h3>Dog Check-In</h3>
            <p>Bring your pup to the registration table. A volunteer will get you squared away and show you where to wait backstage.</p>
          </div>
        </li>
        <li class="timeline-item">
          <span class="timeline-time">5:30 PM</span>
          <div class="timeline-content">
            <h3>The Runway Show Begins</h3>
            <p>Dogs walk the orange carpet one by one. Our emcee announces each competitor and gives the crowd a moment to react.</p>
          </div>
        </li>
        <li class="timeline-item">
          <span class="timeline-time">6:30 PM</span>
          <div class="timeline-content">
            <h3>Judges Deliberate</h3>
            <p>Our panel scores every look on creativity, handler presentation, and crowd response. Scores are tallied behind the scenes.</p>
          </div>
        </li>
        <li class="timeline-item">
          <span class="timeline-time">6:45 PM</span>
          <div class="timeline-content">
            <h3>Best in Show Announced</h3>
            <p>The winner is crowned — and the runner-up and most-creative looks get called out too. Your moment in the spotlight is coming.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ══ REQUIREMENTS ══ -->
  <section class="band band--gold" aria-labelledby="requirements-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">What You Need to Know</p>
        <h2 id="requirements-h">Entry Requirements</h2>
      </div>
      <div class="grid grid--3">
        <div class="card card--accent stack">
          <span class="req-icon" aria-hidden="true">🎟️</span>
          <h3>You Need a Ticket</h3>
          <p>Every handler must have a valid event ticket ($30). Your dog's entry is free — your ticket is not. You can buy one on the registration form or at <a href={SITE.event.ticketUrl} target="_blank" rel="noopener">our ticket page</a>.</p>
        </div>
        <div class="card card--accent stack">
          <span class="req-icon" aria-hidden="true">🐕</span>
          <h3>Dogs Must Be Leashed</h3>
          <p>All dogs must be on leash throughout the event. Your pup should be comfortable in a crowd. No aggressive behavior — this is a celebration for everyone.</p>
        </div>
        <div class="card card--accent stack">
          <span class="req-icon" aria-hidden="true">✨</span>
          <h3>Costumes Encouraged</h3>
          <p>There's no official costume requirement, but the runway is your runway. Go as simple or as spectacular as you like — the crowd will love it either way.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ INSPIRATION ══ -->
  <section class="band" aria-labelledby="inspo-h">
    <div class="container container--narrow">
      <p class="eyebrow">Need Ideas?</p>
      <h2 id="inspo-h">Costume Inspiration</h2>
      <p class="prose">
        Not sure what to dress your dog in? Here are a few directions that always
        bring the house down. Whatever you choose, the most important thing is
        that you and your dog are comfortable and having fun.
      </p>
      <ul class="inspo-tags" aria-label="Costume ideas">
        <li>🦸 Superhero</li>
        <li>👑 Royalty</li>
        <li>🌮 Food</li>
        <li>🎃 Classic Halloween</li>
        <li>👔 Business Formal</li>
        <li>🌊 Nautical</li>
        <li>🎸 Rock Star</li>
        <li>🌺 Tropical Vibes</li>
        <li>🐾 Another Animal</li>
        <li>✨ Whatever You Want</li>
      </ul>
    </div>
  </section>

  <!-- ══ FORM ══ -->
  <section class="band band--teal" aria-labelledby="runway-form">
    <div class="container container--narrow">
      <div class="form-wrap">
        <p class="eyebrow">Register</p>
        {/* TODO: Replace this GUID with the real HubSpot Runway Registration form GUID */}
        <HubSpotForm
          formGuid="00000000-0000-0000-0000-000000000001"
          heading="Register Your Dog for the Runway"
          submitLabel="Submit Registration"
          fields={[
            { name: 'firstname', label: 'Handler first name', type: 'text', required: true, autocomplete: 'given-name' },
            { name: 'lastname', label: 'Handler last name', type: 'text', required: true, autocomplete: 'family-name' },
            { name: 'email', label: 'Email address', type: 'email', required: true },
            { name: 'dog_name', label: "Dog's name", type: 'text', required: true },
            { name: 'dog_breed', label: 'Breed (or best guess)', type: 'text' },
            { name: 'costume_description', label: 'Costume description', type: 'textarea' },
            { name: 'message', label: 'Anything else we should know?', type: 'textarea' },
          ]}
        />
        <p class="form-note">
          Already have your ticket? Great — just let us know on the form.
          Need one? Grab yours at <a href={SITE.event.ticketUrl} target="_blank" rel="noopener">our ticket page</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Show timeline ── */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 5.5rem;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 3px;
    background: var(--color-gold-highlight);
    border-radius: 2px;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-s);
    padding: var(--space-s) 0 var(--space-s) var(--space-m);
    position: relative;
  }
  .timeline-item::before {
    content: '';
    position: absolute;
    left: 4.75rem;
    top: calc(var(--space-s) + 0.35rem);
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--color-accent);
    border: 3px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-accent);
  }
  .timeline-time {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-accent);
    padding-top: 0.25rem;
    text-align: right;
  }
  .timeline-content h3 { margin: 0 0 0.35rem; }
  .timeline-content p { margin: 0; color: var(--color-text-muted); }

  @media (max-width: 34rem) {
    .timeline::before { left: 0.75rem; }
    .timeline-item {
      grid-template-columns: 1fr;
      padding-left: 2.25rem;
    }
    .timeline-item::before { left: 0; }
    .timeline-time { text-align: left; }
  }

  .req-icon { font-size: 2rem; line-height: 1; }

  /* Costume inspiration tag cloud */
  .inspo-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
  }
  .inspo-tags li {
    background: var(--color-teal-tint);
    border: 2px solid var(--color-border);
    border-radius: 50px;
    padding: 0.4rem 1rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  /* Form panel */
  .form-wrap {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-l);
    box-shadow: var(--shadow-sm);
  }
  .form-wrap :global(.hs-form) { max-width: none; }
  .form-wrap :global(.hs-form h2) { margin-top: 0; }
  .form-note {
    margin-top: var(--space-m);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
