---
/**
 * Vendors — interest page for prospective Kennel Club vendors.
 * TODO: Replace formGuid with the real HubSpot Vendor Interest form GUID.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubSpotForm from '../components/HubSpotForm.astro';
import { SITE } from '../config/site.js';

const audienceTags = [
  '🐕 Dog owners', '👨‍👩‍👧 Families', '📸 Photography fans', '🌿 Local shoppers',
  '❤️ Animal lovers', '♿ Accessibility advocates', '🎉 Community supporters',
  '🛍️ Boutique hunters',
];
---

<BaseLayout
  title="Become a Vendor — Kennel Club"
  description="Set up a table in the Kennel Club vendor area at The Fashion PAWty. Connect with Jacksonville dog lovers and community supporters on September 26 at Happy Brew."
>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">The Kennel Club Vendor Area</p>
          <h1>Sell, Share, and Show Up.</h1>
          <p class="prose lead">
            The Fashion PAWty's Kennel Club is your stage. Set up a table, meet
            Jacksonville's community of dog lovers, and put your brand in front
            of an engaged crowd that actually shops local.
          </p>
          <a class="btn btn--primary btn--lg" href="#vendor-form">Apply to Vend</a>
        </div>
        <div class="glance-panel" role="list" aria-label="Event details">
          <div class="glance-item" role="listitem">
            <span class="glance-label">Date</span>
            <span class="glance-value">Saturday, September 26, 2026</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Event Hours</span>
            <span class="glance-value">4:00 – 7:00 PM ET</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Venue</span>
            <span class="glance-value">Happy Brew · 3200 Hendricks Ave · Jacksonville, FL</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Vendor Setup</span>
            <span class="glance-value">Arrive by 3:30 PM to set up</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ AUDIENCE ══ -->
  <section class="band" aria-labelledby="audience-h">
    <div class="container container--narrow">
      <p class="eyebrow">Who You'll Reach</p>
      <h2 id="audience-h">Your Crowd at the PAWty</h2>
      <p class="prose">
        The Fashion PAWty draws an engaged, community-minded crowd — people who
        care about local businesses, love their dogs, and show up to support a
        good cause. This is not a big-box crowd. These are your people.
      </p>
      <ul class="audience-tags" aria-label="Audience types at The Fashion PAWty">
        {audienceTags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </section>

  <!-- ══ FORM ══ -->
  <section class="band" aria-labelledby="vendor-form">
    <div class="container container--narrow">
      <div class="form-wrap">
        <p class="eyebrow">Apply</p>
        {/* TODO: Replace this GUID with the real HubSpot Vendor Interest form GUID */}
        <HubSpotForm
          formGuid="00000000-0000-0000-0000-000000000002"
          heading="Vendor Interest Form"
          submitLabel="Submit Vendor Application"
          fields={[
            { name: 'firstname', label: 'Contact first name', type: 'text', required: true, autocomplete: 'given-name' },
            { name: 'lastname', label: 'Contact last name', type: 'text', required: true, autocomplete: 'family-name' },
            { name: 'email', label: 'Email address', type: 'email', required: true },
            { name: 'phone', label: 'Phone number', type: 'tel', autocomplete: 'tel' },
            { name: 'company', label: 'Business name', type: 'text', required: true },
            { name: 'products_description', label: 'What will you be selling or promoting?', type: 'textarea', required: true },
            { name: 'message', label: 'Anything else we should know?', type: 'textarea' },
          ]}
        />
        <p class="form-note">
          Questions about vendor logistics? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we'll get back to you quickly.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Glance panel */
  .glance-panel {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    box-shadow: var(--shadow-sm);
  }
  .glance-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .glance-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .glance-value { font-weight: 600; font-size: var(--step-0); }

  /* Audience tags */
  .audience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
  }
  .audience-tags li {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 50px;
    padding: 0.4rem 1rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  /* Form panel */
  .form-wrap {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-l);
    box-shadow: var(--shadow-sm);
  }
  .form-wrap :global(.hs-form) { max-width: none; }
  .form-wrap :global(.hs-form h2) { margin-top: 0; }
  .form-note {
    margin-top: var(--space-m);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
