---
/**
 * Vendors — interest page for prospective Kennel Club vendors.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site.js';

---

<BaseLayout
  title="Become a Vendor — Kennel Club"
  description="Set up a table in the Kennel Club vendor area at The Fashion PAWty. Connect with Jacksonville dog lovers and community supporters on September 26 at Happy Brew."
>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">The Kennel Club Vendor Area</p>
          <h1>Sell, Share, and Show Up.</h1>
          <p class="prose lead">
            The Fashion PAWty's Kennel Club is your stage. Set up a table, meet
            Jacksonville's community of dog lovers, and put your brand in front
            of an engaged crowd that actually shops local.
          </p>
          <a class="btn btn--primary btn--lg" href="#vendor-form">Apply to Vend</a>
        </div>
        <div class="glance-panel" role="list" aria-label="Event details">
          <div class="glance-item" role="listitem">
            <span class="glance-label">Date</span>
            <span class="glance-value">Saturday, September 26, 2026</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Event Hours</span>
            <span class="glance-value">4:00 – 7:00 PM ET</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Venue</span>
            <span class="glance-value">Happy Brew · 3200 Hendricks Ave · Jacksonville, FL</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Vendor Setup</span>
            <span class="glance-value">Arrive by 3:30 PM to set up</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHY VEND ══ -->
  <section class="band band--tight" aria-labelledby="why-vend-h">
    <div class="container">
      <h2 id="why-vend-h" class="sr-only">Why become a vendor</h2>
      <div class="why-grid">
        <div class="why-card">
          <p class="why-icon" aria-hidden="true">🐾</p>
          <h3>Your Vendor PAWty Pass includes</h3>
          <ul class="why-list">
            <li>Designated vendor space in the Kennel Club area</li>
            <li>Admission for up to 2 vendor representatives</li>
            <li>Business listing on thefashionpawty.com</li>
            <li>Opportunity to promote and sell your products or services</li>
          </ul>
        </div>
        <div class="why-card">
          <p class="why-icon" aria-hidden="true">📋</p>
          <h3>Before you apply</h3>
          <ul class="why-list">
            <li>Vendors must provide their own tent, tables, chairs, and display materials</li>
            <li>Electricity is not available</li>
            <li>Space is limited — applications are subject to approval</li>
            <li>We encourage family-friendly and dog-friendly displays</li>
          </ul>
        </div>
        <div class="why-card">
          <p class="why-icon" aria-hidden="true">❤️</p>
          <h3>Support a meaningful cause</h3>
          <p>Every vendor at The Fashion PAWty helps us raise funds for Leader Dogs for the Blind and the blind and low-vision community.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ FORM ══ -->
  <section id="vendor-form" class="band band--tight" aria-label="Vendor application form">
    <div class="container container--narrow">
      <div class="form-wrap">
        <script src="https://js.hsforms.net/forms/embed/42383838.js" defer is:inline></script>
        <div
          class="hs-form-frame"
          data-region="na1"
          data-form-id="58d73a8e-9450-4042-9d03-622a374c0aa9"
          data-portal-id="42383838"
        ></div>
        <p class="form-note">
          Questions about vendor logistics? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we'll get back to you quickly.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Glance panel */
  .glance-panel {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    box-shadow: var(--shadow-sm);
  }
  .glance-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .glance-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .glance-value { font-weight: 600; font-size: var(--step-0); }

  /* Why-vend grid */
  .why-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .why-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .why-card {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-m);
  }
  .why-icon { font-size: 1.75rem; margin: 0 0 0.5rem; }
  .why-card h3 { font-size: var(--step-0); margin: 0 0 0.75rem; }
  .why-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .why-list li {
    padding-left: 1.25rem;
    position: relative;
    font-size: 0.95rem;
  }
  .why-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  /* Form panel */
  .form-wrap {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-m);
    box-shadow: var(--shadow-sm);
  }
  .form-wrap :global(.hs-form) { max-width: none; }
  .form-wrap :global(.hs-form h2) { margin-top: 0; }
  .form-wrap :global(input),
  .form-wrap :global(select),
  .form-wrap :global(textarea) { max-width: none; }
  .form-note {
    margin-top: var(--space-m);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
