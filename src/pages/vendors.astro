---
/**
 * Vendors — interest page for prospective Kennel Club vendors.
 * TODO: Replace formGuid with the real HubSpot Vendor Interest form GUID.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubSpotForm from '../components/HubSpotForm.astro';
import { SITE } from '../config/site.js';

const tiers = [
  {
    icon: '🏠',
    name: 'Dog House',
    price: '$200',
    tagline: 'Prime placement. Full setup. Maximum visibility.',
    benefits: [
      'Premium table placement in the Kennel Club',
      '6-foot table + 2 chairs provided',
      'Logo on event signage and website',
      'Social media shout-out before the event',
    ],
    accent: 'var(--color-gold-highlight)',
  },
  {
    icon: '📸',
    name: 'PAW-parazzi',
    price: '$100',
    tagline: 'A great spot to meet Jacksonville dog lovers.',
    benefits: [
      'Standard table placement in the Kennel Club',
      '6-foot table + 2 chairs provided',
      'Name listed on event website',
    ],
    accent: 'var(--color-accent)',
  },
  {
    icon: '🐾',
    name: 'PAWty Animal',
    price: '$50',
    tagline: 'Perfect for small businesses and makers.',
    benefits: [
      'Table space in the Kennel Club',
      '6-foot table provided',
      'Name listed on event website',
    ],
    accent: 'var(--color-border)',
  },
];

const audienceTags = [
  '🐕 Dog owners', '👨‍👩‍👧 Families', '📸 Photography fans', '🌿 Local shoppers',
  '❤️ Animal lovers', '♿ Accessibility advocates', '🎉 Community supporters',
  '🛍️ Boutique hunters',
];
---

<BaseLayout
  title="Become a Vendor — Kennel Club"
  description="Set up a table in the Kennel Club vendor area at The Fashion PAWty. Connect with Jacksonville dog lovers and community supporters on September 26 at Happy Brew."
>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">The Kennel Club Vendor Area</p>
          <h1>Sell, Share, and Show Up.</h1>
          <p class="prose lead">
            The Fashion PAWty's Kennel Club is your stage. Set up a table, meet
            Jacksonville's community of dog lovers, and put your brand in front
            of an engaged crowd that actually shops local.
          </p>
          <a class="btn btn--primary btn--lg" href="#vendor-form">Apply to Vend</a>
        </div>
        <div class="glance-panel" role="list" aria-label="Event details">
          <div class="glance-item" role="listitem">
            <span class="glance-label">Date</span>
            <span class="glance-value">Saturday, September 26, 2026</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Time</span>
            <span class="glance-value">4:00 – 7:00 PM ET</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Venue</span>
            <span class="glance-value">Happy Brew · 3200 Hendricks Ave · Jacksonville, FL</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Setup Time</span>
            <span class="glance-value">Doors open for vendors at 2:30 PM</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ TIERS ══ -->
  <section class="band" aria-labelledby="tiers-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Vendor Packages</p>
        <h2 id="tiers-h">Pick Your Spot in the Kennel Club</h2>
        <p class="prose">
          Every package includes a table and chairs. Select the tier that fits
          your budget and visibility goals — then apply below and we'll confirm
          availability.
        </p>
      </div>
      <ul class="tier-list" role="list">
        {tiers.map((tier) => (
          <li class="tier-card" style={`--tier-accent: ${tier.accent}`}>
            <span class="tier-icon" aria-hidden="true">{tier.icon}</span>
            <div class="tier-body">
              <div class="tier-header">
                <h3 class="tier-name">{tier.name}</h3>
                <span class="tier-price">{tier.price}</span>
              </div>
              <p class="tier-tagline">{tier.tagline}</p>
              <ul class="tier-benefits" aria-label={`${tier.name} package benefits`}>
                {tier.benefits.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
      <p class="tier-note">
        <strong>Note:</strong> The Lions Club Photo Booth station is already claimed.
        All other vendor spots are available on a first-come, first-confirmed basis.
      </p>
    </div>
  </section>

  <!-- ══ AUDIENCE ══ -->
  <section class="band band--gold" aria-labelledby="audience-h">
    <div class="container container--narrow">
      <p class="eyebrow">Who You'll Reach</p>
      <h2 id="audience-h">Your Crowd at the PAWty</h2>
      <p class="prose">
        The Fashion PAWty draws an engaged, community-minded crowd — people who
        care about local businesses, love their dogs, and show up to support a
        good cause. This is not a big-box crowd. These are your people.
      </p>
      <ul class="audience-tags" aria-label="Audience types at The Fashion PAWty">
        {audienceTags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </section>

  <!-- ══ FORM ══ -->
  <section class="band band--teal" aria-labelledby="vendor-form">
    <div class="container container--narrow">
      <div class="form-wrap">
        <p class="eyebrow">Apply</p>
        {/* TODO: Replace this GUID with the real HubSpot Vendor Interest form GUID */}
        <HubSpotForm
          formGuid="00000000-0000-0000-0000-000000000002"
          heading="Vendor Interest Form"
          submitLabel="Submit Vendor Application"
          fields={[
            { name: 'firstname', label: 'Contact first name', type: 'text', required: true, autocomplete: 'given-name' },
            { name: 'lastname', label: 'Contact last name', type: 'text', required: true, autocomplete: 'family-name' },
            { name: 'email', label: 'Email address', type: 'email', required: true },
            { name: 'phone', label: 'Phone number', type: 'tel', autocomplete: 'tel' },
            { name: 'company', label: 'Business name', type: 'text', required: true },
            { name: 'vendor_tier', label: 'Preferred package (Dog House $200 / PAW-parazzi $100 / PAWty Animal $50)', type: 'text' },
            { name: 'products_description', label: 'What will you be selling or promoting?', type: 'textarea', required: true },
            { name: 'message', label: 'Anything else we should know?', type: 'textarea' },
          ]}
        />
        <p class="form-note">
          Questions about vendor logistics? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we'll get back to you quickly.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Glance panel */
  .glance-panel {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    box-shadow: var(--shadow-sm);
  }
  .glance-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .glance-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .glance-value { font-weight: 600; font-size: var(--step-0); }

  /* Tier cards */
  .tier-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tier-card {
    display: flex;
    gap: var(--space-m);
    align-items: flex-start;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-left: 5px solid var(--tier-accent, var(--color-accent));
    border-radius: var(--radius);
    padding: var(--space-m);
    box-shadow: var(--shadow-sm);
  }
  .tier-icon { font-size: 2.5rem; line-height: 1; flex-shrink: 0; }
  .tier-body { flex: 1; min-width: 0; }
  .tier-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-bottom: var(--space-2xs);
  }
  .tier-name { margin: 0; font-size: var(--step-1); }
  .tier-price {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .tier-tagline { color: var(--color-text-muted); margin: 0 0 var(--space-xs); }
  .tier-benefits {
    margin: 0;
    padding: 0 0 0 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .tier-benefits li { color: var(--color-text); }

  .tier-note {
    margin-top: var(--space-m);
    padding: var(--space-s);
    background: var(--color-teal-tint);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }
  html[data-a11y-contrast='high'] .tier-note { background: var(--color-surface); }

  @media (max-width: 34rem) {
    .tier-card { flex-direction: column; }
  }

  /* Audience tags */
  .audience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
  }
  .audience-tags li {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 50px;
    padding: 0.4rem 1rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  html[data-a11y-contrast='high'] .audience-tags li { background: var(--color-surface); }

  /* Form panel */
  .form-wrap {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-l);
    box-shadow: var(--shadow-sm);
  }
  .form-wrap :global(.hs-form) { max-width: none; }
  .form-wrap :global(.hs-form h2) { margin-top: 0; }
  .form-note {
    margin-top: var(--space-m);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
