---
/**
 * Vendors — interest page for prospective Kennel Club vendors.
 * TODO: Replace formGuid with the real HubSpot Vendor Interest form GUID.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubSpotForm from '../components/HubSpotForm.astro';
import { SITE } from '../config/site.js';

---

<BaseLayout
  title="Become a Vendor — Kennel Club"
  description="Set up a table in the Kennel Club vendor area at The Fashion PAWty. Connect with Jacksonville dog lovers and community supporters on September 26 at Happy Brew."
>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">The Kennel Club Vendor Area</p>
          <h1>Sell, Share, and Show Up.</h1>
          <p class="prose lead">
            The Fashion PAWty's Kennel Club is your stage. Set up a table, meet
            Jacksonville's community of dog lovers, and put your brand in front
            of an engaged crowd that actually shops local.
          </p>
          <a class="btn btn--primary btn--lg" href="#vendor-form">Apply to Vend</a>
        </div>
        <div class="glance-panel" role="list" aria-label="Event details">
          <div class="glance-item" role="listitem">
            <span class="glance-label">Date</span>
            <span class="glance-value">Saturday, September 26, 2026</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Event Hours</span>
            <span class="glance-value">4:00 – 7:00 PM ET</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Venue</span>
            <span class="glance-value">Happy Brew · 3200 Hendricks Ave · Jacksonville, FL</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Vendor Setup</span>
            <span class="glance-value">Arrive by 3:30 PM to set up</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ FORM ══ -->
  <section class="band band--tight" aria-labelledby="vendor-form">
    <div class="container container--narrow">
      <div class="form-wrap">
        <p class="eyebrow">Apply</p>
        {/* TODO: Replace this GUID with the real HubSpot Vendor Interest form GUID */}
        <HubSpotForm
          formGuid="00000000-0000-0000-0000-000000000002"
          heading="Vendor Application"
          submitLabel="Submit"
          fields={[
            { name: 'company', label: 'Company name', type: 'text', required: true, autocomplete: 'organization' },
            { name: 'firstname', label: 'First name', type: 'text', required: true, autocomplete: 'given-name' },
            { name: 'lastname', label: 'Last name', type: 'text', required: true, autocomplete: 'family-name' },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'mobilephone', label: 'Mobile phone', type: 'tel', autocomplete: 'tel' },
            { name: 'divider-biz', label: 'Business Information', type: 'divider' },
            { name: 'website', label: 'Website URL', type: 'url', autocomplete: 'url', placeholder: 'https://yourwebsite.com' },
            { name: 'phone', label: 'Phone number', type: 'tel', autocomplete: 'tel' },
            { name: 'business_email', label: 'Business email', type: 'email' },
            { name: 'business_description', label: 'Tell us about your business', type: 'textarea', required: true },
            { name: 'vendor_type', label: 'Fashion PAWty vendor type', type: 'select', required: true, options: [
              { value: 'retail', label: 'Retail / Product' },
              { value: 'food_beverage', label: 'Food & Beverage' },
              { value: 'service', label: 'Service / Experiences' },
              { value: 'nonprofit', label: 'Nonprofit / Cause' },
              { value: 'art_craft', label: 'Art & Craft' },
              { value: 'pet_products', label: 'Pet Products' },
              { value: 'other', label: 'Other' },
            ]},
            { name: 'divider-social', label: 'Social Media', type: 'divider' },
            { name: 'facebook_company_page', label: 'Facebook page', type: 'url', placeholder: 'https://facebook.com/yourbusiness' },
            { name: 'instagram_company_page', label: 'Instagram', type: 'url', placeholder: 'https://instagram.com/yourbusiness' },
            { name: 'linkedin_company_page', label: 'LinkedIn', type: 'url', placeholder: 'https://linkedin.com/company/yourbusiness' },
            { name: 'twitterhandle', label: 'X / Twitter handle', type: 'text', placeholder: '@yourbusiness' },
            { name: 'divider-agree', label: 'Agreement', type: 'divider' },
            { name: 'vendor_liability_agreement', label: 'I agree to the vendor liability terms and will provide my own tent, tables, chairs, and display materials.', type: 'checkbox', required: true },
            { name: 'newsletter_opt_in', label: 'Subscribe to The Fashion PAWty newsletter for event updates and announcements.', type: 'checkbox' },
          ]}
        />
        <p class="form-note">
          Questions about vendor logistics? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we'll get back to you quickly.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Glance panel */
  .glance-panel {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    box-shadow: var(--shadow-sm);
  }
  .glance-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .glance-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .glance-value { font-weight: 600; font-size: var(--step-0); }

  /* Form panel */
  .form-wrap {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-m);
    box-shadow: var(--shadow-sm);
  }
  .form-wrap :global(.hs-form) { max-width: none; }
  .form-wrap :global(.hs-form h2) { margin-top: 0; }
  .form-note {
    margin-top: var(--space-m);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
