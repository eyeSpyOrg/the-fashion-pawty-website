---
/**
 * Partners — recognition page. Thanks sponsors who have signed; it is
 * NOT the selling page (that's /sponsor/, where prices and Stripe links
 * live). Cards are grouped under tier headings in PARTNER_TIER_ORDER;
 * a heading only renders if at least one partner occupies it, so this
 * page grows quietly as more sponsors sign without ever showing an
 * empty section.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerCard from '../components/PartnerCard.astro';
import { PARTNERS, PARTNER_TIER_ORDER } from '../data/partners.js';

const tiers = PARTNER_TIER_ORDER.map((tier) => ({
  tier,
  partners: PARTNERS.filter((p) => p.tier === tier),
}));
---

<BaseLayout
  title="Our Partners"
  description="Meet the businesses partnering with The Fashion PAWty to support Eye Spy Foundation and Leader Dogs for the Blind — see who's sponsoring this year."
>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">Thank You</p>
          <h1>Our Partners</h1>
          <p class="prose lead">
            The Fashion PAWty is only possible because of the businesses
            who partner with us. Thank you to every sponsor below for
            supporting <a href="https://eyespyfoundation.org" target="_blank" rel="noopener">Eye Spy Foundation</a> and Leader Dogs for the Blind.
          </p>
        </div>
        <img
          class="hero-photo"
          src="/images/schedule/runway-hero.webp"
          alt="The Fashion PAWty runway backdrop with a puppy in glasses and a Future Leader Dog bandana"
          width="1600"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══ TIERS ══ -->
  {tiers.map((group) => (
    <section class="band band--tight" aria-labelledby={`tier-${group.tier.toLowerCase().replace(/\s+/g, '-')}-h`}>
      <div class="container container--narrow">
        <h2 id={`tier-${group.tier.toLowerCase().replace(/\s+/g, '-')}-h`}>{group.tier}</h2>
        <ul class="partner-grid">
          {group.partners.map((p) => (
            <PartnerCard
              name={p.name}
              subtitle={p.sponsoredArea ? `${p.sponsoredArea} Sponsor` : undefined}
              logo={p.logo}
              logoAlt=""
              blurb={p.blurb}
              href={p.href}
              buttonText={p.buttonText}
            />
          ))}
          {group.partners.length === 0 && (
            <li class="available-card">
              <div class="available-card__icon" aria-hidden="true">🐾</div>
              <div class="available-card__body">
                <p class="available-card__heading">Sponsorship Still Available</p>
                <p class="available-card__blurb">
                  This tier is open. Join our sponsors and help Eye Spy
                  Foundation reach its $25,000 goal for Leader Dogs for the
                  Blind.
                </p>
                <a class="btn btn--secondary" href="/sponsor/">See Sponsorship Packages</a>
              </div>
            </li>
          )}
        </ul>
      </div>
    </section>
  ))}

  <!-- ══ CLOSING CTA ══ -->
  <section class="band band--dark band--pattern band--tight">
    <div class="container">
      <div class="cta-box">
        <h2>Want to Join Them?</h2>
        <p class="prose">
          See sponsorship packages and pricing on our sponsor page.
        </p>
        <a class="btn btn--onDark btn--lg" href="/sponsor/">See Sponsorship Packages</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .partner-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
  }

  .band--pattern {
    background-color: #000000;
    background-image: url('/assets/patterns/pattern-fullcolordark.png');
    background-size: 14rem;
    background-repeat: repeat;
  }
  html[data-a11y-contrast='high'] .band--pattern { background-image: none; }

  .available-card {
    background: var(--color-surface);
    border: 2px dashed var(--border-hairline);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-s);
    padding: var(--space-m);
  }
  @media (min-width: 40rem) {
    .available-card {
      flex-direction: row;
      text-align: left;
      align-items: center;
    }
  }
  .available-card__icon {
    font-size: 3rem;
    flex-shrink: 0;
    width: 9rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .available-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: center;
  }
  @media (min-width: 40rem) {
    .available-card__body { align-items: flex-start; }
  }
  .available-card__heading {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-text-muted);
  }
  .available-card__blurb { margin: 0; color: var(--color-text-muted); }

  .cta-box {
    background: var(--color-dark);
    color: #ffffff;
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-l) var(--space-m);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: grid;
    gap: var(--space-s);
  }
  .cta-box h2 { margin: 0; }
  .cta-box .prose { margin: 0; }
  .cta-box .btn { justify-self: center; }
  html[data-a11y-contrast='high'] .cta-box {
    background: var(--color-surface);
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }
</style>
