---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/schema/JsonLd.astro';
import { PARTNERS } from '../../data/partners.js';

const partner = PARTNERS.find((p) => p.id === 'jacksonville-arlington-lions-club');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: partner.name,
  url: partner.website,
  sameAs: [partner.website],
};
---

<BaseLayout
  title="Jacksonville Arlington Lions Club — Fashion PAWty Partner"
  description="Jacksonville Arlington Lions Club has served the First Coast since 1938 through vision programs and community outreach — and is the DJ PAWty sponsor of The Fashion PAWty."
  canonical="/partners/jacksonville-arlington-lions-club/"
>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">Fashion PAWty Partner</p>
          <h1>Jacksonville Arlington Lions Club</h1>
          <p class="prose lead">
            A community service organization serving the First Coast since 1938
            through vision programs, hearing assistance, and humanitarian outreach
            guided by the Lions motto "We Serve" — and the DJ PAWty sponsor of
            The Fashion PAWty.
          </p>
          <a
            class="btn btn--primary"
            href={partner.website}
            rel="sponsored"
            target="_blank"
          >
            Visit Their Website
          </a>
          <a class="btn btn--secondary" href="/partners/">View All Partners</a>
        </div>
        <img
          class="hero-photo"
          src={partner.logo}
          alt="Jacksonville Arlington Lions Club logo"
          width="1200"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══ ABOUT ══ -->
  <section class="band band--tight" aria-labelledby="why-h">
    <div class="container container--narrow">
      <h2 id="why-h">Why They're Part of This</h2>
      <p class="prose">
        Jacksonville Arlington Lions Club stepped up as the DJ PAWty sponsor —
        bringing the beats, the energy, and the callouts that keep every guest
        in the PAWty mood from the moment they walk in. That commitment reflects
        everything Lions Clubs International stands for: showing up for the
        community in ways that are felt, not just seen. Their sponsorship funds
        the music, the DJ, and the live shoutouts that make The Fashion PAWty an
        unforgettable experience for guests and participants alike.
      </p>

      <h2 id="what-h">What They Do</h2>
      <p class="prose">
        Established in 1938, Jacksonville Arlington Lions Club is one of the
        First Coast's longest-serving chapters of Lions Clubs International —
        one of the world's largest volunteer-driven service organizations.
        The club serves the Jacksonville community through vision programs,
        hearing assistance, youth initiatives, and humanitarian outreach guided
        by the Lions motto "We Serve." Members show up week after week to make a
        real difference in the lives of their neighbors.
      </p>

      <div class="about-photos">
        <img
          class="photo-slot"
          src="/images/partners/jacksonville-arlington-lions-club-serving.webp"
          alt="Jacksonville Arlington Lions Club members holding an Arlington Lions banner at a community food drive"
          width="1920"
          height="1080"
          loading="lazy"
        />
        <img
          class="photo-slot"
          src="/images/partners/jacksonville-river-city-lions-club-building.webp"
          alt="Jacksonville Lions Club chapter building exterior"
          width="1920"
          height="1080"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ══ WHERE TO FIND THEM ══ -->
  <section class="band band--teal band--tight" aria-labelledby="find-h">
    <div class="container container--narrow">
      <div class="find-row">
        <div>
          <h2 id="find-h">Where to Find Them</h2>
          <p class="prose">
            Club information, meeting schedules, and service opportunities are
            all at their e-clubhouse page.
          </p>
        </div>
        <a
          class="btn btn--primary find-row__btn"
          href={partner.website}
          rel="sponsored"
          target="_blank"
        >
          Visit Their Website
        </a>
      </div>
    </div>
  </section>

  <JsonLd schema={schema} />
</BaseLayout>

<style>
  .lead { font-size: var(--step-1); color: var(--color-text-muted); }
  .split { display: grid; gap: var(--space-l); align-items: center; }
  .split__text > * + * { margin-top: var(--space-s); }
  @media (min-width: 52rem) {
    .split { grid-template-columns: 1.5fr 1fr; gap: var(--space-xl); }
  }
  h1 { text-wrap: balance; }

  .hero-photo {
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: var(--color-surface);
    padding: var(--space-l);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-inline: auto;
  }
  @media (min-width: 52rem) {
    .hero-photo { max-width: none; }
  }

  .about-photos {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }
  @media (min-width: 40rem) {
    .about-photos { grid-template-columns: 1fr 1fr; align-items: start; }
  }

  .photo-slot {
    width: 100%;
    aspect-ratio: 980 / 750;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .find-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
  }
  @media (min-width: 40rem) {
    .find-row { flex-direction: row; align-items: center; justify-content: space-between; }
  }
  .find-row__btn { flex-shrink: 0; }
</style>
