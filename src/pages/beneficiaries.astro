---
/**
 * Beneficiaries — Eye Spy Foundation + Leader Dogs for the Blind.
 * Leader Dogs copy is an original draft pending their sign-off.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { SITE } from '../config/site.js';
---

<BaseLayout
  title="Who the PAWty Helps"
  description="The Fashion PAWty benefits the Eye Spy Foundation and Leader Dogs for the Blind — two organizations helping the blind and low vision community navigate the world with confidence."
>
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">About Our Causes</p>
          <h1>Who the PAWty Helps</h1>
          <p class="prose lead">
            Every wagging tail on the orange carpet supports two organizations
            working to help people navigate the world with confidence.
          </p>
        </div>
        <ImagePlaceholder
          label="The blind and low vision community coming together"
          policy="ai"
          ratio="4 / 3"
          icon="🤝"
          tone="teal"
        />
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="eyespy-h">
    <div class="container split split--balanced">
      <div class="split__text">
        <p class="eyebrow">Presented By</p>
        <h2 id="eyespy-h">Eye Spy Foundation</h2>
        <p class="prose">
          At Eye Spy, we help the blind and low vision community navigate
          community resources so they can live a better low vision lifestyle. We
          greet everyone with a hug or a handshake — because connection comes
          first — and we spend our days pointing people toward the programs,
          services, and tools that make everyday life more accessible. The
          Fashion PAWty is how we bring the whole community together to
          celebrate that mission.
        </p>
        <h3>What does Eye Spy Foundation do?</h3>
        <p class="prose">
          Eye Spy Foundation helps the blind and low vision community
          navigate community resources so they can live a better low vision
          lifestyle — connecting people to the programs, services, and tools
          that make everyday life more accessible.
        </p>
        <p>
          <a class="btn btn--primary" href="https://eyespy.org" target="_blank" rel="noopener">
            Visit EyeSpy.org
          </a>
        </p>
      </div>
      <div class="photo-stack">
        <img
          src="/images/beneficiaries/eyespy-website-mockup.webp"
          alt="The Eye Spy Foundation website homepage displayed on a desktop monitor"
          width="1600"
          height="1200"
          loading="lazy"
        />
        <img
          src="/images/beneficiaries/guide-dog-navigation.webp"
          alt="A woman using a guide dog in harness to navigate near a fountain in downtown Jacksonville"
          width="1600"
          height="1200"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="band band--gold" aria-labelledby="leaderdogs-h">
    <div class="container split split--balanced">
      <div class="split__text">
        <p class="eyebrow">Also Benefiting</p>
        <h2 id="leaderdogs-h">Leader Dogs for the Blind</h2>
        {/* TODO: original draft copy — send to Leader Dogs partnerships contact
            for sign-off and swap in any wording they prefer. */}
        <p class="prose">
          Leader Dogs for the Blind is a guide dog school that raises and trains
          dogs to help people who are blind or low vision travel safely and
          independently. From playful puppies to confident working guides, each
          dog is prepared to become a trusted navigation partner — opening up
          new freedom for the person at the other end of the harness. This year,
          the Eye Spy Foundation is proud to sponsor one Leader Dogs puppy, and
          a portion of every dollar raised at The Fashion PAWty goes directly to
          their work. When you party with us, you help raise a future guide dog.
        </p>
        <h3>What is Leader Dogs for the Blind?</h3>
        <p class="prose">
          Leader Dogs for the Blind is a guide dog school that raises and
          trains dogs to help people who are blind or low vision travel
          safely and independently. The Fashion PAWty supports their mission
          every year.
        </p>
        <p>
          <a class="btn btn--primary" href="https://www.leaderdog.org/" target="_blank" rel="noopener">
            Visit Leader Dogs Website
          </a>
        </p>
      </div>
      <div class="photo-stack">
        <img
          src="/images/beneficiaries/leader-dogs-puppy.webp"
          alt="A golden retriever puppy wearing a 'Future Leader Dog' bandana"
          width="1600"
          height="1200"
          loading="lazy"
        />
        <img
          src="/images/beneficiaries/leader-dogs-staff.webp"
          alt="Leader Dogs for the Blind staff and trainers posing outdoors with their guide dogs"
          width="1600"
          height="1200"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="band band--dark band--pattern">
    <div class="container">
      <div class="cta-box">
        <h2>Support Blind &amp; Low Vision Navigation</h2>
        <div class="cta-band__btns">
          <a class="btn btn--onDark btn--lg" href={SITE.event.ticketUrl} target="_blank" rel="noopener">Join the PAWty</a>
          <a class="btn btn--onDark btn--lg" href="/sponsor/">Become a Sponsor</a>
          <a class="btn btn--onDark btn--lg" href={SITE.shopUrl} target="_blank" rel="noopener">Buy Merch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead { font-size: var(--step-1); color: var(--color-text-muted); }
  .split { display: grid; gap: var(--space-l); align-items: center; }
  .split__text > * + * { margin-top: var(--space-s); }
  @media (min-width: 52rem) {
    .split { grid-template-columns: 1.5fr 1fr; gap: var(--space-xl); }
  }
  h1 { text-wrap: balance; }

  /* Eye Spy Foundation and Leader Dogs sections share this exact layout —
     text on the left, two stacked photos on the right — so the two causes
     read as equally weighted. Even 1fr/1fr columns (rather than the
     Intro band's 1.5fr/1fr) keep the section visually balanced now that
     the image side carries two photos instead of one. */
  .split--balanced { align-items: start; }
  @media (min-width: 52rem) {
    .split--balanced { grid-template-columns: 1fr 1fr; }
  }
  .photo-stack { display: grid; gap: var(--space-m); }
  .photo-stack img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .cta-band__btns { display: flex; gap: var(--space-s); flex-wrap: wrap; justify-content: center; margin-top: var(--space-m); }

  /* Full brand pattern (black canvas, full-color icons) as the actual band
     background — bold, not a faint texture. The CTA copy + buttons live in
     their own solid card on top, so contrast never depends on the busy
     pattern behind it; the card is centered in the strip via margin-inline
     auto rather than relying on text-align alone. */
  .band--pattern {
    background-color: #000000;
    background-image: url('/assets/patterns/pattern-fullcolordark.png');
    background-size: 14rem;
    background-repeat: repeat;
  }
  html[data-a11y-contrast='high'] .band--pattern { background-image: none; }

  .cta-box {
    background: var(--color-dark);
    color: #ffffff;
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-l) var(--space-m);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .cta-box h2 { margin: 0; }
  html[data-a11y-contrast='high'] .cta-box {
    background: var(--color-surface);
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }
</style>
