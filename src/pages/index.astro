---
/**
 * Homepage — hero, quick facts, impact, fundraising goal, feature
 * sections, FAQ, email signup, closing CTA, sponsor callout.
 * Event + FAQPage schema generated from the same data rendered below.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import PawDonationMeter from '../components/PawDonationMeter.astro';
import SizzleReel from '../components/SizzleReel.astro';
import EventSchema from '../components/schema/EventSchema.astro';
import { SITE } from '../config/site.js';

const facts = [
  { icon: '📍', label: 'Where', value: 'Happy Brew Coffee Shop, Jacksonville, FL' },
  { icon: '📅', label: 'When', value: 'September 26 · 4 – 7 PM' },
  { icon: '🎟️', label: 'Tickets', value: '$30 · Runway show, food, mocktails, music, family fun' },
];

const loveReasons = [
  {
    icon: '🎉',
    title: 'A Day of Fun',
    text: 'Watch local dogs show off their style on the orange carpet while enjoying music, games, food, and mocktails.',
  },
  {
    icon: '💛',
    title: 'A Meaningful Mission',
    text: 'Your attendance helps support Eye Spy Foundation and Leader Dogs for the Blind.',
  },
  {
    icon: '🤝',
    title: 'A Community Event',
    text: 'Meet local businesses, nonprofits, dog lovers, and families from across Jacksonville.',
  },
];

const requirements = [
  'Represent a local cause or business',
  'Friendly and comfortable around people',
  'Up to date on vaccinations',
  'Ready to work the orange carpet',
];

const shopCategories = [
  { image: '/images/shop/men.webp', label: 'Men', alt: 'A man wearing a Fashion PAWty print polo shirt' },
  { image: '/images/shop/women.webp', label: 'Women', alt: 'A woman wearing a black Fashion PAWty T-shirt' },
  { image: '/images/shop/kids.webp', label: 'Kids', alt: "White kids' clogs with a Fashion PAWty dog and bow-tie print" },
  { image: '/images/shop/dogs.webp', label: 'Pets', alt: 'A golden retriever wearing a Fashion PAWty trucker hat' },
  { image: '/images/shop/gifts.webp', label: 'Gifts', alt: 'Fashion PAWty branded dog-print gift socks' },
  { image: '/images/shop/pawty.webp', label: 'PAWty Collections', alt: "Two 'Let's PAWty' pickleball paddles and balls" },
];

const faqs = [
  {
    question: 'What is The Fashion PAWty?',
    answer:
      'The Fashion PAWty is a community dog fashion show hosted by Eye Spy Foundation where local pups walk the orange carpet to help raise support for Eye Spy Foundation and Leader Dogs for the Blind.',
  },
  {
    question: 'When and where is the event?',
    answer: [
      'Saturday, September 26 from 4 – 7 PM at Happy Brew Coffee Shop, 3200 Hendricks Ave, Jacksonville, FL 32207. ',
      { text: 'View the Venue Page', href: '/venue/' },
      '.',
    ],
  },
  {
    question: 'How much are tickets?',
    answer: [
      'PAWty Passes are $30 and include admission, food, mocktails, music, family fun, and the fashion show. ',
      { text: 'Join the PAWty', href: SITE.event.ticketUrl, external: true },
    ],
  },
  {
    question: 'Are kids allowed?',
    answer:
      'Absolutely. Children under 12 attend free when accompanied by an adult. Guests 12 and older should purchase a PAWty Pass.',
  },
  {
    question: 'Will there be food?',
    answer: [
      'Yes. Your PAWty Pass includes food from ',
      { text: 'Ole Mexican Restaurant', href: 'https://olemexjax.com/', external: true },
      '. Vegetarian and gluten-free options will also be available.',
    ],
  },
  {
    question: 'Can I bring my dog?',
    answer:
      'To ensure a safe and enjoyable event for everyone, only dogs participating in the fashion show may attend. We love all pups, but space and safety considerations require us to limit attendance to registered runway participants.',
  },
  {
    question: 'Can my dog be in the show?',
    answer:
      "Maybe! We're looking for 10–15 amazing dogs to walk the runway. Participants should represent a local cause or business, be comfortable around crowds, be current on vaccinations, and be ready to show off their style. Use our contact form to inquire about participating.",
  },
  {
    question: 'Can I volunteer?',
    answer: [
      "Yes. We're always looking for friendly volunteers to help with setup, check-in, activities, and event support. View our ",
      { text: 'Contact page', href: '/contact/' },
      ' to get involved.',
    ],
  },
  {
    question: 'Who benefits from the event?',
    answer: [
      'The Fashion PAWty supports Eye Spy Foundation and Leader Dogs for the Blind. Funds raised help support community resources, accessibility initiatives, and guide dog programs. View our ',
      { text: 'Beneficiaries page', href: '/beneficiaries/' },
      ' to learn more.',
    ],
  },
  {
    question: 'Do I need to dress up?',
    answer:
      "Not at all. Come as you are, or have fun dressing in your best orange-carpet style. But if you're feeling the vibe, costumes are more than welcome.",
  },
];

const pageDescription =
  "The Fashion PAWty is Jacksonville's dog fashion show benefiting Eye Spy Foundation & Leader Dogs for the Blind — a family-friendly event, Sep 26 at Happy Brew.";
---

<BaseLayout title="Jacksonville Dog Fashion Show" description={pageDescription}>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container hero">
      <div class="hero__copy panel">
        <p class="eyebrow">About the Event</p>
        <h1>Jacksonville's Most Stylish Dog Event</h1>
        <p class="hero__tagline">Dogs. Mocktails. Music. Community.</p>
        <p class="prose lead">
          Join us September 26 at Happy Brew as local pups strut the orange
          carpet for a family-friendly Jacksonville event supporting Eye Spy
          Foundation and Leader Dogs for the Blind.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary btn--lg" href={SITE.event.ticketUrl} target="_blank" rel="noopener">Get Your PAWty Pass</a>
          <a class="btn btn--secondary btn--lg" href="/sponsor/">Become a Sponsor</a>
        </div>
      </div>
      <div class="hero__media">
        <img
          class="hero-photo"
          src="/images/schedule/runway-hero.webp"
          alt="The Fashion PAWty runway backdrop with a puppy in glasses and a Future Leader Dog bandana"
          width="1600"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══ QUICK FACTS ══ -->
  <section class="band" aria-labelledby="facts-heading">
    <div class="container">
      <h2 id="facts-heading" class="sr-only">Event at a glance</h2>
      <ul class="facts grid grid--3">
        {facts.map((f) => (
          <li class="card fact">
            <span class="fact__icon" aria-hidden="true">{f.icon}</span>
            <span class="fact__label">{f.label}</span>
            <span class="fact__value">{f.value}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ IMPACT ══ -->
  <section class="band band--teal" aria-labelledby="about-heading">
    <div class="container split">
      <div class="split__text">
        <p class="eyebrow">Style. Paws. Purpose.</p>
        <h2 id="about-heading">Every Pawstep Makes a Difference</h2>
        <p class="prose">
          Every ticket, sponsorship, and tail wag helps support programs that
          connect the blind and low vision community with resources,
          technology, and opportunities — while also helping train future
          guide dogs through Leader Dogs for the Blind.
        </p>
        <p><a class="btn btn--primary" href={SITE.event.ticketUrl} target="_blank" rel="noopener">Grab a PAWty Pass</a></p>
      </div>
      <img
        class="hero-photo"
        src="/images/beneficiaries/leader-dogs-puppy.webp"
        alt="A golden retriever puppy wearing a 'Future Leader Dog' bandana"
        width="1600"
        height="1200"
        loading="lazy"
      />
    </div>
  </section>

  <!-- ══ GOAL (dark band) ══ -->
  <section class="band band--dark" aria-labelledby="goal-heading">
    <div class="container split split--center">
      <div class="split__text">
        <p class="eyebrow">Our $25,000 Goal</p>
        <h2 id="goal-heading">Help Us Reach $25,000</h2>
        <p class="prose">
          Every ticket, sponsorship, and wagging tail brings this Jacksonville
          dog fashion show closer to $25,000 for programs that matter.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--onDark btn--lg" href="/sponsor/">See sponsorship tiers</a>
          <a class="btn btn--onDark btn--lg" href={SITE.event.ticketUrl} target="_blank" rel="noopener">Get tickets</a>
        </div>
      </div>
      {/* TODO: update `raised` as sponsorships/donations come in — that's
          the only value that needs to change to move the meter. */}
      <PawDonationMeter goal={25000} raised={1250} />
    </div>
  </section>

  <!-- ══ WHY PEOPLE LOVE THE PAWTY ══ -->
  <section class="band" aria-labelledby="love-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Why People Love It</p>
        <h2 id="love-heading">A Jacksonville Dog Event Like No Other</h2>
      </div>
      <ul class="grid grid--3 love-list">
        {loveReasons.map((r) => (
          <li class="card love-card">
            <span class="love-card__icon" aria-hidden="true">{r.icon}</span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══ SIZZLE REEL — inactive for now, keep for when the real reel lands ══
  <section class="band" aria-labelledby="video-heading">
    <div class="container container--narrow stack">
      <div class="section-head section-head--center">
        <p class="eyebrow">Take a Look</p>
        <h2 id="video-heading">Take a Look at the PAWty</h2>
        <p class="prose mx-auto">
          Our sizzle reel is on its way. Here's where you'll press play.
        </p>
      </div>
      TODO: pass youtubeId="VIDEO_ID" once the real reel is uploaded.
      TODO: add VideoObject schema when the real YouTube URL exists.
      <SizzleReel />
    </div>
  </section>
  */}

  {/* ══ WANT YOUR DOG TO STRUT — hidden for now, keep for when casting reopens ══
  <section class="band band--teal" aria-labelledby="strut-heading">
    <div class="container split">
      <div class="split__text">
        <p class="eyebrow">Runway Casting</p>
        <h2 id="strut-heading">Think Your Pup Has What It Takes?</h2>
        <p class="prose">
          We're looking for 10–15 amazing dogs to participate in this year's
          show.
        </p>
        <ul class="req-list">
          {requirements.map((r) => (
            <li><span aria-hidden="true">✓</span> {r}</li>
          ))}
        </ul>
        <p><a class="btn btn--primary btn--lg" href="/contact/">Apply for the Runway</a></p>
      </div>
      <div class="card card--accent stack">
        <h3>A Dog-Friendly Community Fundraiser</h3>
        <p class="prose">
          This Jacksonville pet event is built around real dogs and real
          neighbors — the runway is the heart of the show, and every
          applicant helps make it possible.
        </p>
      </div>
    </div>
  </section>
  */}

  <!-- ══ BENEFICIARIES TEASER ══ -->
  <section class="band band--gold" aria-labelledby="benef-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Who the PAWty Helps</p>
        <h2 id="benef-heading">Every Wagging Tail Supports Two Missions</h2>
      </div>
      <div class="grid grid--2">
        <article class="card card--accent card--link stack">
          <img
            class="card-photo"
            src="/images/sponsors/eyespy-logo-card.webp"
            alt="Eye Spy Foundation logo"
            width="1600"
            height="1200"
            loading="lazy"
          />
          <h3>Eye Spy Foundation</h3>
          <p>
            Eye Spy Foundation helps the blind and low vision community
            discover resources, build connections, and grow confidence
            through technology, education, and support. We're creating a
            more connected future while welcoming everyone with a hug, a
            handshake, and a sense of belonging.
          </p>
          <p><a href="/beneficiaries/">Meet Eye Spy Foundation</a></p>
        </article>
        <article class="card card--accent card--link stack">
          <img
            class="card-photo"
            src="/images/sponsors/leaderdogs-logo-card.webp"
            alt="Leader Dogs for the Blind logo"
            width="1600"
            height="1200"
            loading="lazy"
          />
          <h3>Leader Dogs for the Blind</h3>
          <p>
            A portion of every purchase helps support a future Leader Dog
            puppy on its journey to becoming a guide dog. Through expert
            training and care, these remarkable dogs help people travel
            with greater confidence, independence, and freedom.
          </p>
          <p><a href="/beneficiaries/">Learn about Leader Dogs for the Blind</a></p>
        </article>
      </div>
    </div>
  </section>

{/* ══ SHOP — hidden for now, the merch store isn't live yet ══
  <section class="band band--teal" aria-labelledby="shop-heading">
    <div class="container">
      <div class="section-head section-head--center shop-intro">
        <p class="eyebrow">Shop the Collection</p>
        <h2 id="shop-heading">The Fashion PAWty Store</h2>
        <p class="prose mx-auto">
          Discover exclusive apparel, accessories, gifts, and pet gear
          inspired by Jacksonville's most stylish fundraiser for dogs and
          their humans.
        </p>
        <a class="btn btn--primary btn--lg" href={SITE.shopUrl} target="_blank" rel="noopener">Shop the Collections</a>
      </div>
      TODO: point each tile at its own shop collection URL once
      shop.thefashionpawty.com has per-category collection pages.
      <ul class="grid grid--3 shop-grid">
        {shopCategories.map((c) => (
          <li class="shop-card">
            <a href={SITE.shopUrl} target="_blank" rel="noopener">
              <img
                class="shop-card__photo"
                src={c.image}
                alt={c.alt}
                width="1000"
                height="1000"
                loading="lazy"
              />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  */}

  <!-- ══ FAQ ══ -->
  <section class="band">
    <div class="container container--narrow">
      <p class="eyebrow">Good to Know</p>
      <FAQ faqs={faqs} heading="Frequently Asked Questions" />
      <p class="prose">
        More questions? Visit the <a href="/faq/">full FAQ page</a> or email
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>

{/* ══ EMAIL SIGNUP — hidden: the footer now has a real, sitewide
    HubSpot-powered signup, so this page-level duplicate (and its mailto
    fallback) is redundant. Keep for reference in case the footer strip
    ever goes away. ══
  <section class="band band--teal" aria-labelledby="dispatch-heading">
    <div class="container container--narrow signup-cta">
      <p class="eyebrow">Stay Connected</p>
      <h2 id="dispatch-heading">The Fashion PAWty Newsletter</h2>
      <p class="prose mx-auto">
        Get event updates, dog spotlights, sponsor announcements, and PAWty
        news delivered to your inbox.
      </p>
      <a
        class="btn btn--primary btn--lg"
        href={`mailto:${SITE.email}?subject=${encodeURIComponent('The Fashion PAWty Newsletter')}`}
      >
        Join the List
      </a>
    </div>
  </section>
  */}

  <!-- ══ CLOSING CTA ══ -->
  <section class="band band--dark" aria-labelledby="closing-heading">
    <div class="container container--narrow swag-cta">
      <p class="eyebrow">One Last Thing</p>
      <h2 id="closing-heading">Ready to Strut for a Cause?</h2>
      <p class="prose mx-auto">
        Spend an afternoon with great people, incredible dogs, delicious
        food, and a mission that matters.
      </p>
      <div class="hero__ctas closing-ctas">
        <a class="btn btn--onDark btn--lg" href={SITE.event.ticketUrl} target="_blank" rel="noopener">Get Tickets</a>
        <a class="btn btn--onDark btn--lg" href="/sponsor/">Become a Sponsor</a>
        <a class="btn btn--onDark btn--lg" href="/contact/">Volunteer</a>
      </div>
    </div>
  </section>

  <EventSchema />
</BaseLayout>

<style>
  /* Hero: two-column on wide screens, stacked on small */
  .hero { display: grid; gap: var(--space-m); align-items: center; }
  .hero__copy > * + * { margin-top: var(--space-s); }
  .hero__tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--color-accent);
  }
  .hero .lead { font-size: var(--step-1); color: var(--color-text-muted); }
  .hero__ctas { display: flex; gap: var(--space-s); flex-wrap: wrap; margin-top: var(--space-m); }
  @media (min-width: 52rem) {
    .hero { grid-template-columns: 1.15fr 0.85fr; gap: var(--space-l); }
    /* Tighter than the shared .panel padding/spacing so the whole hero
       (picture, copy, buttons) fits above the fold on common desktop
       viewport heights — only scoped to the hero, other bands keep the
       standard .panel look. */
    .hero__copy { padding: var(--space-s) var(--space-m); }
    .hero__copy > * + * { margin-top: var(--space-xs); }
    .hero h1 { font-size: var(--step-2); }
    .hero .lead { font-size: var(--step-0); }
    .hero__ctas { margin-top: var(--space-s); }
  }

  .hero-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .card-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  /* Facts: icon + label + value cards */
  .facts { list-style: none; margin: 0; padding: 0; }
  .fact { display: grid; gap: 0.35rem; }
  .fact__icon { font-size: 2rem; line-height: 1; }
  .fact__label {
    font-family: var(--font-display);
    font-weight: 700; font-size: 0.8rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-accent);
  }
  .fact__value { font-weight: 600; }

  /* Split: text beside media */
  .split { display: grid; gap: var(--space-l); align-items: center; }
  .split__text > * + * { margin-top: var(--space-s); }
  @media (min-width: 52rem) {
    .split { grid-template-columns: 1fr 1fr; gap: var(--space-xl); }
    .split--center { align-items: center; }
  }

  .swag-cta { text-align: center; }
  .swag-cta .eyebrow { justify-content: center; }
  .swag-cta .btn { margin-top: var(--space-m); }
  .closing-ctas { justify-content: center; }

  /* Why People Love card list */
  .love-list { list-style: none; margin: 0; padding: 0; }
  .love-card { display: grid; gap: 0.5rem; text-align: center; justify-items: center; }
  .love-card__icon { font-size: 2.25rem; line-height: 1; }

  /* Requirements list on the runway-casting section */
  .req-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .req-list li { display: flex; align-items: flex-start; gap: 0.5rem; }
  .req-list span[aria-hidden] { color: var(--color-accent); font-weight: 700; }

  .signup-cta { text-align: center; }
  .signup-cta .eyebrow { justify-content: center; }
  .signup-cta .btn { margin-top: var(--space-m); }

  /* Shop category tiles */
  .shop-grid { list-style: none; margin: 0; padding: 0; margin-top: var(--space-l); }
  .shop-card a {
    display: block;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
  }
  .shop-card a:hover { border-color: var(--color-accent); }
  .shop-card__photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }
  .shop-intro .btn { margin-top: var(--space-m); }
</style>
