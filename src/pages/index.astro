---
/**
 * Homepage — post-event thank-you, 2026 recap, and 2027 Save the Date.
 * Replaces the pre-event homepage after September 26, 2026.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PawDonationMeter from '../components/PawDonationMeter.astro';
import JsonLd from '../components/schema/JsonLd.astro';
import { SITE } from '../config/site.js';
import { PARTNERS, PARTNER_TIER_ORDER } from '../data/partners.js';

const pageTitle = 'The Fashion PAWty 2026 — Thank You Jacksonville';
const pageDescription =
  'The Fashion PAWty 2026 raised $12,000 for Eye Spy Foundation and Leader Dogs for the Blind. Thank you, Jacksonville — save the date for The Fashion PAWty 2027!';

const sponsorsByTier = PARTNER_TIER_ORDER.map((tier) => ({
  tier,
  partners: PARTNERS.filter((p) => p.tier === tier),
})).filter((g) => g.partners.length > 0);

const statCards = [
  {
    value: 80,
    suffix: '+',
    label: 'Guests at Happy Brew',
    image: '/images/gallery/runway-2026-dog.webp',
    alt: 'A dog in an orange and blue striped outfit greeting a young guest on the runway at The Fashion PAWty 2026',
  },
  {
    value: 9,
    suffix: '',
    label: 'Dogs on the Runway',
    image: '/images/gallery/runway-2026-white-dog.webp',
    alt: 'A white fluffy dog wearing a pink tiara walks the orange carpet runway at The Fashion PAWty 2026',
  },
  {
    value: 9,
    suffix: '',
    label: 'Sponsors Who Made It Possible',
    image: '/images/partners/jacksonville-river-city-lions-club-donation.webp',
    alt: 'Jacksonville River City Lions Club members at a donation event — the Best in Show sponsor of The Fashion PAWty 2026',
  },
];

const interestCards = [
  {
    icon: '🎟️',
    title: 'Attend in 2027',
    text: 'Be the first to know when PAWty Passes go on sale for The Fashion PAWty 2027.',
    href: '/contact/',
    cta: 'Count Me In',
  },
  {
    icon: '🤝',
    title: 'Become a Sponsor',
    text: "Put your brand at the heart of Jacksonville's most stylish fundraiser.",
    href: '/sponsor/',
    cta: 'Explore Sponsorship',
  },
  {
    icon: '🐾',
    title: 'Enter the Runway',
    text: 'Does your pup have what it takes to strut the orange carpet in 2027?',
    href: '/runway/',
    cta: 'Apply for the Runway',
  },
  {
    icon: '💛',
    title: 'Volunteer',
    text: 'Help us make 2027 even bigger and better. Every helping hand matters.',
    href: '/volunteer/',
    cta: 'Volunteer with Us',
  },
];

const event2027Schema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'The Fashion PAWty 2027',
  startDate: '2027-09-25T16:00:00-04:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Happy Brew',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '3200 Hendricks Ave',
      addressLocality: 'Jacksonville',
      addressRegion: 'FL',
      postalCode: '32207',
      addressCountry: 'US',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Eye Spy Foundation',
    url: SITE.url,
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
    <JsonLd schema={event2027Schema} />
  </Fragment>

  <!-- ══ HERO — Thank You ══ -->
  <section class="band band--teal band--tight">
    <div class="container hero">
      <div class="hero__copy panel">
        <p class="eyebrow">The Fashion PAWty 2026</p>
        <h1>Thank You, Jacksonville.</h1>
        <p class="hero__tagline">You showed up. You gave. You made a difference.</p>
        <p class="hero__raised">$12,000<span class="hero__raised-plus">+</span> Raised</p>
        <p class="prose lead">
          On September 26, 2026, Jacksonville came together at Happy Brew for
          dogs, mocktails, music, and a mission — raising <strong>$12,000</strong>
          for Eye Spy Foundation and Leader Dogs for the Blind.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary btn--lg" href="/gallery/2026/">See the Photos</a>
          <a class="btn btn--secondary btn--lg" href="/donate/">Donate</a>
        </div>
      </div>
      <div class="hero__media">
        <img
          class="hero-photo"
          src="/images/gallery/runway-2026-hero.webp"
          alt="Emcee on stage at The Fashion PAWty 2026 runway at Happy Brew, Jacksonville, with families and children seated on the lawn"
          width="1456"
          height="816"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══ IMPACT — paw meter + stat cards ══ -->
  <section class="band band--dark" aria-labelledby="impact-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow impact-eyebrow">2026 By the Numbers</p>
        <h2 id="impact-heading">What We Accomplished Together</h2>
      </div>

      <!-- Paw meter: $12,000 raised toward $25,000 goal -->
      <div class="impact-layout">
        <div class="impact-meter">
          <PawDonationMeter goal={25000} raised={12000} />
          <a class="btn btn--onDark impact-donate-btn" href="/donate/">Donate</a>
        </div>

        <!-- Three stat cards with images and count-up numbers -->
        <ul class="stat-cards">
          {statCards.map((s) => (
            <li class="stat-card card">
              <img
                class="stat-card__photo"
                src={s.image}
                alt={s.alt}
                width="800"
                height="600"
                loading="lazy"
              />
              <div class="stat-card__body">
                <span
                  class="stat-card__value"
                  data-countup
                  data-target={s.value}
                  data-suffix={s.suffix}
                  aria-label={`${s.value}${s.suffix} ${s.label}`}
                >
                  {s.value}{s.suffix}
                </span>
                <span class="stat-card__label">{s.label}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ══ GALLERY ══ -->
  <section class="band band--teal" aria-labelledby="gallery-heading">
    <div class="container container--narrow gallery-cta">
      <p class="eyebrow">The Memories</p>
      <h2 id="gallery-heading">Relive the PAWty</h2>
      <p class="prose mx-auto">
        From the orange carpet to the runway stage, the 2026 Fashion PAWty
        was a night to remember. Browse the full gallery to see your favorite
        moments from the event.
      </p>
      <a class="btn btn--primary btn--lg" href="/gallery/2026/">View the 2026 Gallery</a>
    </div>
  </section>

  <!-- ══ MISSION / IMPACT ══ -->
  <section class="band band--gold" aria-labelledby="mission-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">The Mission Behind the PAWty</p>
        <h2 id="mission-heading">Every Dollar Moves the Needle</h2>
      </div>
      <div class="grid grid--2">
        <article class="card card--accent stack">
          <img
            class="card-photo"
            src="/images/sponsors/eyespy-logo-card.webp"
            alt="Eye Spy Foundation logo"
            width="1600"
            height="1200"
            loading="lazy"
          />
          <h3>Eye Spy Foundation</h3>
          <p>
            Funds raised support the blind and low vision community through
            resources, technology, education, and connection — so no one
            faces vision loss alone.
          </p>
          <p><a href="/beneficiaries/">Learn about Eye Spy Foundation</a></p>
        </article>
        <article class="card card--accent stack">
          <img
            class="card-photo"
            src="/images/sponsors/leaderdogs-logo-card.webp"
            alt="Leader Dogs for the Blind logo"
            width="1600"
            height="1200"
            loading="lazy"
          />
          <h3>Leader Dogs for the Blind</h3>
          <p>
            A portion of every dollar helps train future guide dogs — giving
            people who are blind or have low vision the freedom and confidence
            to navigate the world.
          </p>
          <p><a href="/beneficiaries/">Learn about Leader Dogs for the Blind</a></p>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ SPONSORS ══ -->
  <section class="band" aria-labelledby="sponsors-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">It Takes a Village</p>
        <h2 id="sponsors-heading">Thank You to Our 2026 Sponsors</h2>
        <p class="prose mx-auto">
          None of this would be possible without the generosity of our
          sponsors. They believed in the mission and helped make the PAWty
          a reality.
        </p>
      </div>
      {sponsorsByTier.map(({ tier, partners }) => (
        <div class="sponsor-tier">
          <h3 class="sponsor-tier__name">{tier}</h3>
          <ul class="sponsor-tier__list grid grid--3">
            {partners.map((p) => (
              <li class="card sponsor-card">
                <img
                  class="sponsor-card__logo"
                  src={p.logo}
                  alt={`${p.name} logo`}
                  width="400"
                  height="300"
                  loading="lazy"
                />
                <p class="sponsor-card__name">{p.name}</p>
                <p class="sponsor-card__area">{p.sponsoredArea}</p>
                <a href={p.href} class="sponsor-card__link">
                  Meet {p.name.split(' ').slice(0, 3).join(' ')}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ══ SAVE THE DATE 2027 ══ -->
  <section class="band band--dark" aria-labelledby="std-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow std-eyebrow">Save the Date</p>
        <h2 id="std-heading">The Fashion PAWty Is Coming Back in 2027</h2>
        <p class="prose std-sub">
          Mark your calendar: <strong>September 25, 2027</strong> at Happy Brew,
          3200 Hendricks Ave, Jacksonville, FL. More dogs. More style. More
          mission. Tell us how you want to be involved.
        </p>
      </div>
      <ul class="interest-grid grid grid--2">
        {interestCards.map((card) => (
          <li class="card interest-card">
            <span class="interest-card__icon" aria-hidden="true">{card.icon}</span>
            <h3 class="interest-card__title">{card.title}</h3>
            <p class="interest-card__text">{card.text}</p>
            <a class="btn btn--primary" href={card.href}>{card.cta}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══ STAY CONNECTED — removed post-launch; footer newsletter handles sign-ups ══
  <section class="band band--teal" aria-labelledby="connect-heading">
    <div class="container container--narrow">
      <p class="eyebrow">Stay in the Loop</p>
      <h2 id="connect-heading">Don't Miss a Single PAWty Update</h2>
      <p class="prose mx-auto">...</p>
    </div>
  </section>
  */}
</BaseLayout>

<script>
  /* Count-up animation — runs when the stat enters the viewport.
     Skipped entirely under prefers-reduced-motion or data-a11y-motion=off
     so the final number is shown immediately instead. */
  const reduceMotion =
    document.documentElement.getAttribute('data-a11y-motion') === 'off' ||
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const DURATION = 1200; // ms

    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target ?? '0', 10);
      const suffix = el.dataset.suffix ?? '';
      const start = performance.now();

      const tick = (now: number) => {
        const elapsed = Math.min(now - start, DURATION);
        // ease-out quad
        const progress = 1 - Math.pow(1 - elapsed / DURATION, 2);
        const current = Math.round(target * progress);
        el.textContent = `${current}${suffix}`;
        if (elapsed < DURATION) requestAnimationFrame(tick);
        else el.textContent = `${target}${suffix}`;
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 },
    );

    document.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) =>
      observer.observe(el),
    );
  }
</script>

<style>
  /* Hero */
  .hero { display: grid; gap: var(--space-m); align-items: center; }
  .hero__copy > * + * { margin-top: var(--space-s); }
  .hero__tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--color-accent);
  }
  .hero__raised {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    margin: 0;
  }
  .hero__raised-plus { color: var(--color-gold-highlight); }
  .hero__ctas { display: flex; gap: var(--space-s); flex-wrap: wrap; margin-top: var(--space-m); }
  @media (min-width: 52rem) {
    .hero { grid-template-columns: 1.15fr 0.85fr; gap: var(--space-l); }
    .hero__copy { padding: var(--space-s) var(--space-m); }
    .hero__copy > * + * { margin-top: var(--space-xs); }
    .hero h1 { font-size: var(--step-2); }
    .hero .lead { font-size: var(--step-0); }
    .hero__ctas { margin-top: var(--space-s); }
  }

  /* Impact section */
  .impact-eyebrow { justify-content: center; color: var(--color-gold-highlight); }

  .impact-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    margin-top: var(--space-l);
  }
  .impact-meter { display: flex; flex-direction: column; align-items: center; }
  .impact-donate-btn { margin-top: var(--space-s); display: inline-block; }
  @media (min-width: 52rem) {
    .impact-layout {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
      gap: var(--space-xl);
    }
    .impact-meter { flex-shrink: 0; }
  }

  /* Stat cards — image + number + label */
  .stat-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
    width: 100%;
  }
  @media (max-width: 51.99rem) {
    .stat-cards { grid-template-columns: 1fr; }
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    gap: 0;
  }
  .stat-card__photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .stat-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: var(--space-s) var(--space-m);
    text-align: center;
  }
  .stat-card__value {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }
  .stat-card__label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }

  /* Split layout */
  .split { display: grid; gap: var(--space-l); align-items: center; }
  .split__text > * + * { margin-top: var(--space-s); }
  @media (min-width: 52rem) {
    .split { grid-template-columns: 1fr 1fr; gap: var(--space-xl); }
    .split--center { align-items: center; }
  }

  /* Gallery CTA strip */
  .gallery-cta { text-align: center; }
  .gallery-cta .eyebrow { justify-content: center; }
  .gallery-cta .btn { margin-top: var(--space-m); }

  /* Mission card photos */
  .card-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  /* Sponsor tiers */
  .sponsor-tier { margin-top: var(--space-xl); }
  .sponsor-tier__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-accent);
    text-align: center;
    margin-bottom: var(--space-m);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .sponsor-tier__list { list-style: none; margin: 0; padding: 0; }
  .sponsor-card { display: grid; gap: var(--space-xs); text-align: center; justify-items: center; }
  .sponsor-card__logo {
    width: 100%;
    max-width: 12rem;
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }
  .sponsor-card__name { font-weight: 700; font-size: 0.95rem; margin: 0; color: var(--color-text); }
  .sponsor-card__area { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; }
  .sponsor-card__link { font-size: 0.9rem; color: var(--color-accent); text-decoration: underline; }

  /* Save the Date 2027 */
  .std-eyebrow { justify-content: center; color: var(--color-gold-highlight); }
  .std-sub { color: rgba(255,255,255,0.9); }
  .interest-grid { list-style: none; margin: 0; padding: 0; margin-top: var(--space-l); }
  .interest-card {
    display: grid;
    gap: var(--space-s);
    text-align: center;
    justify-items: center;
    align-content: start;
  }
  .interest-card__icon { font-size: 2.25rem; line-height: 1; }
  /* Cards sit on --color-surface (white); override band--dark's h3/p color cascade */
  .interest-card__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-text) !important;
    margin: 0;
  }
  .interest-card__text {
    color: var(--color-text-muted) !important;
    margin: 0;
    font-size: 0.95rem;
  }
</style>
