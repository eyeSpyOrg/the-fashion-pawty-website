---
/**
 * Sponsor — sponsorship packages for The Fashion PAWty.
 *
 * Tiers are grouped into four sections that mirror the physical packages:
 *   Main Sponsor (1, full-width) > Top Dog Sponsorships (3, signature zones) >
 *   PAWty Animal (6 — five activity areas + Kennel Club vendor tent,
 *   styled differently since it's a space rental, not an activity naming
 *   right) > Media Sponsorships (3).
 *
 * Each group feeds both the visible cards and SponsorshipSchema, so the
 * structured data can never drift from what a visitor actually reads
 * (same discipline as the FAQ component).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import SponsorshipSchema from '../components/schema/SponsorshipSchema.astro';
import { SITE } from '../config/site.js';

const mainSponsor = [
  {
    title: 'Best in Show',
    fullName: 'Best in Show Sponsorship (Main Sponsor)',
    price: 5000,
    qty: 1,
    shortCopy: 'Become the presenting sponsor with runway naming rights and live mentions.',
    stripeUrl: 'https://buy.stripe.com/8x2dR85Pa1t72dd2YSejK02',
    icon: '🏆',
  },
];

const topDog = [
  {
    title: 'Music',
    fullName: 'Top Dog: Music Stage Sponsor',
    price: 2000,
    qty: 1,
    shortCopy: 'Sponsor the Music Stage with exclusive naming rights and branded signage.',
    stripeUrl: 'https://buy.stripe.com/cNibJ0cdy1t7g430QKejK03',
    icon: '🎵',
  },
  {
    title: 'Chow Down',
    fullName: 'Top Dog: Chow Down Station Sponsor',
    price: 2000,
    qty: 1,
    shortCopy: 'Sponsor the Chow Down Station with exclusive naming rights and signage.',
    stripeUrl: 'https://buy.stripe.com/4gM4gy3H21t79FFgPIejK04',
    icon: '🍔',
  },
  {
    title: 'Mocktails',
    fullName: 'Top Dog: MockTAIL Bar Sponsor',
    price: 2000,
    qty: 1,
    shortCopy: 'Sponsor the MockTAIL Bar with exclusive naming rights and branded signage.',
    stripeUrl: 'https://buy.stripe.com/aFa4gy6Te2xbcRRdDwejK05',
    icon: '🍹',
  },
];

const pawtyAnimal = [
  {
    title: 'Photo Wall',
    fullName: 'PAWty Animal: Photo Wall Sponsor',
    price: 1000,
    qty: 1,
    shortCopy: 'Sponsor the Photo Wall and get your brand woven into guest memories.',
    stripeUrl: 'https://buy.stripe.com/7sYeVc6Te1t7g436b4ejK06',
    icon: '📸',
  },
  {
    title: 'Merch Shop',
    fullName: 'PAWty Animal: Merch Shop Sponsor',
    price: 1000,
    qty: 1,
    shortCopy: 'Sponsor the Merch Shop and get your brand in front of every guest.',
    stripeUrl: 'https://buy.stripe.com/9B614m91m9ZD7xx2YSejK07',
    icon: '🧢',
  },
  {
    title: 'Bone Up',
    fullName: 'PAWty Animal: Bone Up Station Sponsor',
    price: 1000,
    qty: 1,
    shortCopy: 'Sponsor the Bone Up Station and support guest engagement and fun.',
    stripeUrl: 'https://buy.stripe.com/dRm7sKfpKfjX4ll6b4ejK08',
    icon: '🦴',
  },
  {
    title: 'DJ PAWty',
    fullName: 'PAWty Animal: DJ PAWty Sponsor',
    price: 1000,
    qty: 1,
    shortCopy: 'Sponsor the DJ PAWty and keep the music and energy going all day.',
    stripeUrl: 'https://buy.stripe.com/8x28wO0uQfjX3hh570ejK09',
    icon: '🎧',
  },
  {
    title: 'Sensory Games',
    fullName: 'PAWty Animal: Sensory Games Sponsor',
    price: 1000,
    qty: 1,
    shortCopy: 'Sponsor Sensory Games and create inclusive fun for all guests.',
    stripeUrl: 'https://buy.stripe.com/9B628q91m6Nr5pp0QKejK0a',
    icon: '🧩',
  },
  {
    title: 'Kennel Club',
    subtitle: 'Vendor Tent',
    fullName: 'Kennel Club: Vendor Tent',
    price: 250,
    qty: 4,
    shortCopy: 'Reserve a 10x10 vendor tent and get featured on our event map.',
    stripeUrl: 'https://buy.stripe.com/dRm8wOcdy8Vz8BBczsejK0b',
    icon: '⛺',
    variant: 'alt',
  },
];

const media = [
  {
    title: 'The Doggie Dispatch',
    subtitle: 'Email Sponsor',
    fullName: 'The Doggie Dispatch: Email Sponsor',
    price: 200,
    qty: 5,
    shortCopy: 'Get featured in our official PAWty email to dog lovers and supporters.',
    stripeUrl: 'https://buy.stripe.com/eVqdR8fpK7Rv8BBbvoejK0c',
    icon: '📬',
  },
  {
    title: 'PAWty Post',
    subtitle: 'Social Media Sponsor',
    fullName: 'PAWty Post: Social Media Sponsor',
    price: 150,
    qty: 10,
    shortCopy: 'Score a dedicated shout-out post on our social channels to engaged followers.',
    stripeUrl: 'https://buy.stripe.com/dRmfZga5q4FjdVV0QKejK0d',
    icon: '📣',
  },
  {
    title: 'Doggie Bag Stuffer',
    subtitle: 'Welcome Bag Insert',
    fullName: 'Doggie Bag Stuffer: Welcome Bag Insert',
    price: 75,
    qty: 15,
    shortCopy: "Place your item in every guest's welcome bag for easy brand visibility.",
    stripeUrl: 'https://buy.stripe.com/7sYdR81yU2xb4ll9ngejK0e',
    icon: '🎁',
  },
];

/* One flat list drives the structured data — same tiers rendered above. */
const allTiers = [...mainSponsor, ...topDog, ...pawtyAnimal, ...media].map((t) => ({
  name: t.fullName,
  price: t.price,
  qty: t.qty,
  description: t.shortCopy,
}));

const money = (n: number) => `$${n.toLocaleString('en-US')}`;
---

<BaseLayout
  title="Sponsor the PAWty"
  description="Sponsor The Fashion PAWty, hosted by the Eye Spy Foundation — packages from $75–$5,000 supporting the blind and low vision community and Leader Dogs."
>
  <!-- ══ INTRO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">About Sponsorship</p>
          <h1>Sponsor the PAWty</h1>
          <p class="prose lead">
            Every sponsorship helps fund The Fashion PAWty and supports the Eye
            Spy Foundation's mission to create a more accessible world for the
            blind and low vision community. Pick your package, put your brand at
            the center of the orange carpet, and help us reach our $25,000 goal.
          </p>
        </div>
        <ImagePlaceholder
          label="Sponsorship opportunities at The Fashion PAWty"
          policy="ai"
          ratio="4 / 3"
          icon="💰"
          tone="teal"
        />
      </div>
    </div>
  </section>

  <!-- ══ WHY SPONSOR (AEO) ══ -->
  <section class="band band--tight">
    <div class="container container--narrow">
      <h2>Why Sponsor The Fashion PAWty?</h2>
      <p class="prose">
        Sponsorship dollars fund the Eye Spy Foundation and Leader Dogs for
        the Blind, helping the blind and low vision community navigate the
        world with more confidence — while putting your brand in front of an
        engaged Jacksonville audience.
      </p>
    </div>
  </section>

  <!-- ══ 1. MAIN SPONSOR ══ -->
  <section class="band" aria-labelledby="main-sponsor-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Presenting Sponsor</p>
        <h2 id="main-sponsor-h">Main Sponsor</h2>
      </div>

      <ul class="tier-grid tier-grid--1">
        {mainSponsor.map((tier) => (
          <li class="sponsor-card">
            <div class="sponsor-card__image">
              <img
                src="/images/sponsors/sponsor-placeholder.jpg"
                alt={`Placeholder — ${tier.title} sponsor logo goes here`}
                width="600"
                height="600"
                loading="lazy"
              />
            </div>
            <div class="sponsor-card__content">
              <h3 class="sponsor-card__title">{tier.title}</h3>
              <p class="sponsor-card__copy">{tier.shortCopy}</p>
              <div class="sponsor-card__footer">
                <p class="sponsor-card__price">{money(tier.price)}</p>
              </div>
            </div>
            <a class="btn btn--primary btn--block" href={tier.stripeUrl} rel="noopener">
              Become a Sponsor
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ 2. TOP DOG SPONSORSHIPS ══ -->
  <section class="band band--teal" aria-labelledby="top-dog-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Signature Zones</p>
        <h2 id="top-dog-h">Top Dog Sponsorships</h2>
      </div>

      <ul class="tier-grid tier-grid--3">
        {topDog.map((tier) => (
          <li class="sponsor-card">
            <div class="sponsor-card__image">
              <img
                src="/images/sponsors/sponsor-placeholder.jpg"
                alt={`Placeholder — ${tier.title} sponsor logo goes here`}
                width="600"
                height="600"
                loading="lazy"
              />
            </div>
            <div class="sponsor-card__content">
              <h3 class="sponsor-card__title">{tier.title}</h3>
              <p class="sponsor-card__copy">{tier.shortCopy}</p>
              <div class="sponsor-card__footer">
                <p class="sponsor-card__price">{money(tier.price)}</p>
              </div>
            </div>
            <a class="btn btn--primary btn--block" href={tier.stripeUrl} rel="noopener">
              Become a Sponsor
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ 3. PAWTY ANIMAL ══ -->
  <section class="band" aria-labelledby="pawty-animal-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Activity Areas</p>
        <h2 id="pawty-animal-h">PAWty Animal</h2>
      </div>

      <ul class="tier-grid tier-grid--3">
        {pawtyAnimal.map((tier) => (
          <li class:list={['sponsor-card', tier.variant === 'alt' && 'sponsor-card--alt']}>
            <div class="sponsor-card__image">
              <img
                src="/images/sponsors/sponsor-placeholder.jpg"
                alt={`Placeholder — ${tier.title} sponsor logo goes here`}
                width="600"
                height="600"
                loading="lazy"
              />
            </div>
            <div class="sponsor-card__content">
              <h3 class="sponsor-card__title">{tier.title}</h3>
              {tier.subtitle && <p class="sponsor-card__subtitle">{tier.subtitle}</p>}
              <p class="sponsor-card__copy">{tier.shortCopy}</p>
              <div class="sponsor-card__footer">
                <p class="sponsor-card__price">{money(tier.price)}</p>
              </div>
            </div>
            <a class="btn btn--primary btn--block" href={tier.stripeUrl} rel="noopener">
              Become a Sponsor
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ 4. MEDIA SPONSORSHIPS ══ -->
  <section class="band band--teal" aria-labelledby="media-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Before, During &amp; After</p>
        <h2 id="media-h">Media Sponsorships</h2>
      </div>

      <ul class="tier-grid tier-grid--3">
        {media.map((tier) => (
          <li class="sponsor-card">
            <div class="sponsor-card__image">
              <img
                src="/images/sponsors/sponsor-placeholder.jpg"
                alt={`Placeholder — ${tier.title} sponsor logo goes here`}
                width="600"
                height="600"
                loading="lazy"
              />
            </div>
            <div class="sponsor-card__content">
              <h3 class="sponsor-card__title">{tier.title}</h3>
              {tier.subtitle && <p class="sponsor-card__subtitle">{tier.subtitle}</p>}
              <p class="sponsor-card__copy">{tier.shortCopy}</p>
              <div class="sponsor-card__footer">
                <p class="sponsor-card__price">{money(tier.price)}</p>
              </div>
            </div>
            <a class="btn btn--primary btn--block" href={tier.stripeUrl} rel="noopener">
              Become a Sponsor
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ HELP ══ -->
  <section class="band band--gold" aria-labelledby="help-h">
    <div class="container container--narrow">
      <div class="section-head">
        <p class="eyebrow">Need Help Deciding</p>
        <h2 id="help-h">Find Your Perfect Package</h2>
      </div>
      <p class="prose help">
        Not sure which package fits? Email
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we'll help you
        find the right spot on the orange carpet.
      </p>
    </div>
  </section>

  <SponsorshipSchema tiers={allTiers} url="/sponsors/" />
</BaseLayout>

<style>
  .lead { font-size: var(--step-1); color: var(--color-text-muted); }

  .split { display: grid; gap: var(--space-l); align-items: center; }
  .split__text > * + * { margin-top: var(--space-s); }
  @media (min-width: 52rem) {
    .split { grid-template-columns: 1.5fr 1fr; gap: var(--space-xl); }
  }
  h1 { text-wrap: balance; }

  /* ── Tier Grid ── */
  .tier-grid {
    display: grid;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: 1fr;
  }
  .tier-grid--1 {
    max-width: 28rem;
    margin-inline: auto;
  }
  @media (min-width: 48rem) {
    .tier-grid--3 { grid-template-columns: repeat(2, 1fr); gap: var(--space-l); }
  }
  @media (min-width: 68rem) {
    .tier-grid--3 { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Sponsor Card ── */
  .sponsor-card {
    background: var(--color-surface);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    overflow: hidden;
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .sponsor-card:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
  html[data-a11y-motion='off'] .sponsor-card:hover { transform: none; }
  @media (prefers-reduced-motion: reduce) { .sponsor-card:hover { transform: none; } }

  /* Kennel Club — a space rental, not an activity naming right, so it
     gets a visually distinct treatment (gold vs. teal) inside the
     PAWty Animal grid rather than its own section. */
  .sponsor-card--alt {
    background: var(--color-gold-tint);
    border: 2px solid var(--color-gold-highlight);
  }
  :global(html[data-a11y-contrast='high']) .sponsor-card--alt {
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  .sponsor-card__image {
    width: 100%;
    overflow: hidden;
  }

  .sponsor-card__content {
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex-grow: 1;
  }

  .sponsor-card__title {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
  }

  .sponsor-card__subtitle {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .sponsor-card__copy {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    min-height: 3.5rem;
    display: flex;
    align-items: center;
  }

  .sponsor-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--border-hairline);
  }

  .sponsor-card__price {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--color-accent);
  }

  .sponsor-card .btn {
    margin-top: auto;
    margin-left: var(--space-m);
    margin-right: var(--space-m);
    margin-bottom: var(--space-m);
  }

  .help { margin-top: var(--space-m); }
</style>
