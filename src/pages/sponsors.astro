---
/**
 * Sponsor — sponsorship packages for The Fashion PAWty.
 *
 * Tier data lives in ONE array per group and feeds both the visible cards
 * and SponsorshipSchema, so the structured data can never drift from what
 * a visitor actually reads (same discipline as the FAQ component).
 *
 * Visual hierarchy is deliberate and descends with price:
 *   Best in Show (featured, full width) > Top Dog (wide) >
 *   PAWty Animal (5-up) > Kennel Club (compact) > Media (3-up, smallest)
 *
 * Card treatment is elevation + alpha-blended borders only — no colored
 * side rules, no icons in colored circles, no gradients.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import SponsorshipSchema from '../components/schema/SponsorshipSchema.astro';
import { SITE } from '../config/site.js';

/* TODO: TEMPORARY — every tier currently points at one generic Stripe
   donation link. Replace with a tier-specific Stripe Payment Link per
   package (so amounts are pre-set and reporting is per-tier) before launch. */
const STRIPE_URL = 'https://donate.stripe.com/dRmcN43H25Jng43eHAejK00';

const bestInShow = {
  name: 'Best in Show',
  price: 5000,
  qty: 1,
  shortCopy: 'Become the presenting sponsor with runway naming rights and live mentions.',
  fullDescription:
    'Become the presenting sponsor of The Fashion PAWty. Best in Show sponsors get exclusive runway naming rights, top billing across all event materials, and live mic mentions throughout the show.',
  icon: '🏆',
};

const topDog = {
  name: 'Top Dog',
  price: 2000,
  qty: 3,
  shortCopy: 'Sponsor a signature zone with exclusive naming rights and signage.',
  fullDescription:
    'Sponsor a Signature Zone — Music, Food, or Mock-tails — with exclusive naming rights and branded area signage seen by every guest.',
  icon: '🐕',
};

const pawtyAnimal = {
  name: 'PAWty Animal',
  price: 1000,
  qty: 5,
  shortCopy: 'Sponsor an activity area and get your brand woven into the fun.',
  fullDescription:
    'Sponsor an Activity Area — Photo Wall, Merch Shop, Bone Up Station, DJ PAWty, or Sensory Games — and get your brand woven into the fun.',
  icon: '🎉',
};

const kennelClub = {
  name: 'Kennel Club',
  price: 250,
  qty: 4,
  shortCopy: 'Reserve a vendor tent and get featured on our event map.',
  fullDescription:
    'Reserve a 10x10 vendor tent at The Fashion PAWty. Get featured on our event map and website so guests can find you.',
  icon: '⛺',
};

const mediaTiers = [
  {
    name: 'The Doggie Dispatch',
    price: 200,
    qty: 5,
    icon: '📬',
    shortCopy: 'Get featured in our official PAWty email to the community.',
    fullDescription:
      'Get featured in one of our official Fashion PAWty emails, sent straight to our full list of dog lovers and community supporters.',
  },
  {
    name: 'PAWty Post',
    price: 150,
    qty: 10,
    icon: '📣',
    shortCopy: 'Score a dedicated shout-out post on our social channels.',
    fullDescription:
      'Score a dedicated shout-out post on our social channels, tagging your brand in front of our engaged community.',
  },
  {
    name: 'Doggie Bag Stuffer',
    price: 75,
    qty: 15,
    icon: '🎁',
    shortCopy: 'Place your item directly into every guest's welcome bag.',
    fullDescription:
      "Put your item or insert directly into every guest's welcome bag — an easy, affordable way to get noticed.",
  },
];

/* One flat list drives the structured data — same objects rendered above. */
const allTiers = [bestInShow, topDog, pawtyAnimal, kennelClub, ...mediaTiers];

const money = (n: number) => `$${n.toLocaleString('en-US')}`;
const availability = (n: number) =>
  n === 1 ? 'Only 1 available' : `${n} available`;
---

<BaseLayout
  title="Sponsor the PAWty"
  description="Sponsor The Fashion PAWty — packages from $75 to $5,000 with runway naming rights, branded zones, and vendor tents, supporting the blind and low vision community."
>
  <!-- ══ INTRO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">About Sponsorship</p>
          <h1>Sponsor the PAWty</h1>
          <p class="prose lead">
            Every sponsorship helps fund The Fashion PAWty and supports the Eye
            Spy Foundation's mission to create a more accessible world for the
            blind and low vision community. Pick your package, put your brand at
            the center of the orange carpet, and help us reach our $25,000 goal.
          </p>
        </div>
        <ImagePlaceholder
          label="Sponsorship opportunities at The Fashion PAWty"
          policy="ai"
          ratio="4 / 3"
          icon="💰"
          tone="teal"
        />
      </div>
    </div>
  </section>

  <!-- ══ ALL SPONSORSHIP TIERS ══ -->
  <section class="band" aria-labelledby="tiers-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Sponsorship Options</p>
        <h2 id="tiers-h">Choose Your Package</h2>
      </div>

      <ul class="sponsorship-grid">
        {allTiers.map((tier) => (
          <li class="sponsor-card">
            <div class="sponsor-card__image">
              <ImagePlaceholder
                label={tier.name}
                policy="ai"
                ratio="4 / 3"
                icon={tier.icon}
              />
            </div>
            <div class="sponsor-card__content">
              <h3 class="sponsor-card__title">{tier.name}</h3>
              <p class="sponsor-card__copy">{tier.shortCopy}</p>
              <div class="sponsor-card__footer">
                <p class="sponsor-card__price">{money(tier.price)}</p>
                <p class="sponsor-card__qty">{availability(tier.qty)}</p>
              </div>
            </div>
            <a class="btn btn--primary btn--block" href={SITE.event.ticketUrl} rel="noopener">
              Get Tickets
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ THANK YOU + HELP ══ -->
  <section class="band band--gold" aria-labelledby="thanks-h">
    <div class="container container--narrow">
      <div class="section-head">
        <p class="eyebrow">Thank You</p>
        <h2 id="thanks-h">Already on the Team</h2>
      </div>
      <article class="tier-card tier-card--compact">
        <span class="tier-card__icon" aria-hidden="true">📸</span>
        <div class="tier-card__text">
          <h3 class="tier-card__title">Photo Booth</h3>
          <p class="tier-card__desc">
            Proudly sponsored by the <strong>Lions Club of Jacksonville
            Beach</strong>. Thank you for helping the PAWty shine!
          </p>
        </div>
      </article>
      <p class="prose help">
        Not sure which package fits? Email
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we'll help you
        find the right spot on the orange carpet.
      </p>
    </div>
  </section>

  <SponsorshipSchema tiers={allTiers} url="/sponsors/" />
</BaseLayout>

<style>
  .lead { font-size: var(--step-1); color: var(--color-text-muted); }

  .split { display: grid; gap: var(--space-l); align-items: center; }
  .split__text > * + * { margin-top: var(--space-s); }
  @media (min-width: 52rem) {
    .split { grid-template-columns: 1.5fr 1fr; gap: var(--space-xl); }
  }
  h1 { text-wrap: balance; }

  /* ── Sponsorship Grid ── */
  .sponsorship-grid {
    display: grid;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .sponsorship-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-l); }
  }
  @media (min-width: 68rem) {
    .sponsorship-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Sponsor Card ── */
  .sponsor-card {
    background: var(--color-surface);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    overflow: hidden;
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .sponsor-card:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
  html[data-a11y-motion='off'] .sponsor-card:hover { transform: none; }
  @media (prefers-reduced-motion: reduce) { .sponsor-card:hover { transform: none; } }

  .sponsor-card__image {
    width: 100%;
    overflow: hidden;
  }

  .sponsor-card__content {
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex-grow: 1;
  }

  .sponsor-card__title {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
  }

  .sponsor-card__copy {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    min-height: 3.5rem;
    display: flex;
    align-items: center;
  }

  .sponsor-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--border-hairline);
  }

  .sponsor-card__price {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--color-accent);
  }

  .sponsor-card__qty {
    margin: 0;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .sponsor-card .btn {
    margin-top: auto;
    margin-left: var(--space-m);
    margin-right: var(--space-m);
    margin-bottom: var(--space-m);
  }

  .help { margin-top: var(--space-m); }
</style>
