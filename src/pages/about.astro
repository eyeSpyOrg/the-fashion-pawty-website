---
/**
 * About — hub page for The Fashion PAWty.
 * Hero + mission copy + three hub cards + FAQ replacing event strip.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site.js';
---

<BaseLayout
  title="About the Event"
  description="The Fashion PAWty is a dog fashion show and community celebration on Sep 26, 2026 at Happy Brew, Jacksonville — benefiting the Eye Spy Foundation and Leader Dogs for the Blind."
>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">About The Fashion PAWty</p>
          <h1>A dog fashion show with a purpose.</h1>
          <p class="prose lead">
            On September 26, 2026, Happy Brew in Jacksonville rolls out the orange
            carpet for a one-of-a-kind night — dogs in costume, mocktails in hand,
            music in the air, and a community united around making the world more
            accessible for the blind and low vision community.
          </p>
          <div class="hero-actions">
            <a class="btn btn--primary btn--lg" href={SITE.event.ticketUrl} target="_blank" rel="noopener">
              Get Tickets — $30
            </a>
            <a class="btn btn--secondary" href="/beneficiaries/">Our Causes</a>
          </div>
        </div>
        <!-- Replace with real Eye Spy Foundation event photo after Sep 26 -->
        <img
          class="hero-photo"
          src="/images/about/eye-spy-foundation.webp"
          alt="Eye Spy Foundation — helping the blind and low vision community navigate resources and live a fuller life"
          width="1600"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══ MISSION ══ -->
  <section class="band" aria-labelledby="mission-h">
    <div class="container container--narrow">
      <p class="eyebrow">Our Mission</p>
      <h2 id="mission-h">Why we throw this PAWty</h2>
      <p class="prose">
        The Eye Spy Foundation helps the blind and low vision community navigate
        community resources so they can live a better low vision lifestyle. The
        Fashion PAWty is how we bring Jacksonville together to celebrate that
        mission — and fund it. Every ticket, every sponsorship, every vendor
        booth helps us reach our $25,000 fundraising goal.
      </p>
      <p class="prose">
        This year, The Fashion PAWty also benefits{' '}
        <a href="https://www.leaderdog.org/" target="_blank" rel="noopener noreferrer">
          Leader Dogs for the Blind
        </a>{' '}
        — a guide dog school that pairs people with trusted navigation partners.
        When you come to the PAWty, you help raise a future guide dog.
      </p>
      <p class="prose">
        Tickets include entry, food, and mocktails — so come hungry, come
        stylish, and bring your four-legged best friend if they've got an outfit
        to show off.
      </p>
      <p>
        <a class="btn btn--secondary" href="/beneficiaries/">Meet the causes we support</a>
      </p>
    </div>
  </section>

  <!-- ══ HUB CARDS — 3 across ══ -->
  <section class="band band--teal" aria-labelledby="hub-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Get Involved</p>
        <h2 id="hub-h">How to be part of the PAWty</h2>
      </div>

      <ul class="hub-grid" role="list">
        <li>
          <a class="hub-card" href="/volunteer/">
            <span class="hub-card__icon" aria-hidden="true">🐾</span>
            <h3 class="hub-card__title">Volunteer</h3>
            <p class="hub-card__copy">Lend a paw. We need a crew for check-in, runway coordination, vendor support, and more.</p>
            <span class="hub-card__cta">Sign up to volunteer →</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="/sponsor/">
            <span class="hub-card__icon" aria-hidden="true">🏆</span>
            <h3 class="hub-card__title">Become a Sponsor</h3>
            <p class="hub-card__copy">Put your brand at the center of the runway show. Packages from $75 to $5,000.</p>
            <span class="hub-card__cta">View sponsorship packages →</span>
          </a>
        </li>
        <li>
          <a class="hub-card" href="/vendors/">
            <span class="hub-card__icon" aria-hidden="true">🛍️</span>
            <h3 class="hub-card__title">Vendors</h3>
            <p class="hub-card__copy">Set up a table in the Kennel Club vendor area and reach a crowd of dog lovers.</p>
            <span class="hub-card__cta">Apply to vend →</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ══ FAQ ══ -->
  <section class="band" aria-labelledby="faq-h">
    <div class="container container--narrow">
      <p class="eyebrow">Questions &amp; Answers</p>
      <h2 id="faq-h">About the Eye Spy Foundation</h2>

      <dl class="faq-list">

        <div class="faq-item">
          <dt>What is the Eye Spy Foundation?</dt>
          <dd>
            The <a href="https://www.eyespy.org/" target="_blank" rel="noopener noreferrer">Eye Spy Foundation (ESF)</a>
            is a Jacksonville-based nonprofit dedicated to helping the blind and low vision community
            navigate community resources and live a fuller, more independent life. ESF connects people
            with services, tools, and support so they can thrive — at home, at work, and in their community.
          </dd>
        </div>

        <div class="faq-item">
          <dt>What is EyeSpy.org?</dt>
          <dd>
            <a href="https://www.eyespy.org/" target="_blank" rel="noopener noreferrer">EyeSpy.org</a> is the
            home of the Eye Spy Foundation online. You'll find information about the foundation's programs,
            resources for the blind and low vision community, and ways to get involved — from volunteering
            to donating. The Fashion PAWty is one of the foundation's signature fundraising events.
          </dd>
        </div>

        <div class="faq-item">
          <dt>Where do the funds raised go?</dt>
          <dd>
            Every dollar raised through The Fashion PAWty supports two organizations. The majority of
            proceeds benefit the <a href="https://www.eyespy.org/" target="_blank" rel="noopener noreferrer">Eye Spy Foundation</a>,
            funding programs that connect the blind and low vision community with navigation resources
            and lifestyle support. A portion of proceeds also benefits
            <a href="https://www.leaderdog.org/" target="_blank" rel="noopener noreferrer">Leader Dogs for the Blind</a>,
            which trains and places guide dogs with people who are blind or have low vision.
            Our fundraising goal is $25,000. <a href="/beneficiaries/">Learn more about who we help →</a>
          </dd>
        </div>

        <div class="faq-item">
          <dt>Who is Leader Dogs for the Blind?</dt>
          <dd>
            <a href="https://www.leaderdog.org/" target="_blank" rel="noopener noreferrer">Leader Dogs for the Blind</a>
            is a Michigan-based nonprofit that has been training guide dogs and providing orientation and
            mobility services since 1939. They pair people who are blind or have low vision with
            highly trained guide dogs — at no cost to the client. By attending The Fashion PAWty,
            you help fund the next generation of guide dogs.
          </dd>
        </div>

        <div class="faq-item">
          <dt>How does the Eye Spy Foundation help the blind and low vision community?</dt>
          <dd>
            ESF focuses on navigation — helping people find and access the community resources,
            services, and tools that make low vision life more manageable and more connected. This
            includes everything from technology resources to community programs. The Fashion PAWty
            directly funds that work. <a href="https://www.eyespy.org/" target="_blank" rel="noopener noreferrer">Visit EyeSpy.org to learn more →</a>
          </dd>
        </div>

        <div class="faq-item">
          <dt>How can I get involved beyond buying a ticket?</dt>
          <dd>
            There are several ways to make a bigger impact: <a href="/volunteer/">volunteer</a> on event
            day, <a href="/sponsor/">become a sponsor</a> with packages starting at $75, or
            <a href="/vendors/">set up a vendor table</a> in our Kennel Club vendor area. You can
            also <a href="https://www.eyespy.org/" target="_blank" rel="noopener noreferrer">follow the Eye Spy Foundation</a>
            year-round. Every bit of support helps us serve the blind and low vision community in Jacksonville and beyond.
          </dd>
        </div>

      </dl>
    </div>
  </section>

</BaseLayout>

<style>
  .hero-actions { display: flex; gap: var(--space-s); flex-wrap: wrap; margin-top: var(--space-m); }

  /* ── Hub grid — 3 across on desktop, stacked on mobile ── */
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 48rem) {
    .hub-grid { grid-template-columns: 1fr; }
  }
  @media (min-width: 30rem) and (max-width: 48rem) {
    .hub-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .hub-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-top: 5px solid var(--color-gold-highlight);
    border-radius: var(--radius);
    padding: var(--space-m);
    text-decoration: none;
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hub-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  @media (prefers-reduced-motion: reduce) { .hub-card:hover { transform: none; } }
  :global(html[data-a11y-motion='off']) .hub-card:hover { transform: none; }

  .hub-card__icon { font-size: 2.5rem; line-height: 1; }
  .hub-card__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin: 0;
    color: var(--color-text);
  }
  .hub-card__copy {
    font-size: var(--step-0);
    color: var(--color-text-muted);
    flex: 1;
    margin: 0;
  }
  .hub-card__cta {
    font-weight: 700;
    color: var(--color-accent);
    font-size: 0.9rem;
    margin-top: var(--space-2xs);
  }

  /* ── FAQ ── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    margin-top: var(--space-m);
  }
  .faq-item {
    border-left: 4px solid var(--color-gold-highlight);
    padding-left: var(--space-s);
  }
  .faq-item dt {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-2xs);
  }
  .faq-item dd {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }
  .faq-item dd a {
    color: var(--color-accent);
    font-weight: 600;
  }
  .faq-item dd a:hover { text-decoration: underline; }
</style>
