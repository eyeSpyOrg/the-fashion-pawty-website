---
/**
 * PAWtners — out-of-town / can't-attend audience. Reads as joining a
 * movement, not a transaction: "support," "join," and "PAWtner" instead of
 * "donate." No Attend/ticket section — not relevant to this audience.
 * Shares level data and structure with /donate
 * (src/data/donationTiers.js, DonationLevels/DonationLevelCard) — only
 * CTA wording and two level titles differ.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import DonationLevels from '../components/DonationLevels.astro';
// import SwagSection from '../components/SwagSection.astro';
import ShareSection from '../components/ShareSection.astro';
---

<BaseLayout
  title="Become a PAWtner — Support From Anywhere"
  description="Become a PAWtner and support The Fashion PAWty from anywhere — your gift helps Eye Spy Foundation and Leader Dogs for the Blind build community and confidence."
>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">Join the Mission From Anywhere</p>
          <h1>Become a PAWtner</h1>
          <p class="prose lead">
            You don't have to attend The Fashion PAWty to make a
            difference. Become a PAWtner and help Eye Spy Foundation and
            Leader Dogs for the Blind build community and confidence —
            from anywhere.
          </p>
          <a class="btn btn--primary btn--lg" href="#puppy-pawty">See PAWtner Levels</a>
        </div>
        <img
          class="hero-photo"
          src="/images/schedule/runway-hero.webp"
          alt="The Fashion PAWty runway backdrop with a puppy in glasses and a Future Leader Dog bandana"
          width="1600"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══ SUPPORT — pooled-funds line + 5 levels ══ -->
  <DonationLevels variant="pawtners" />

  <!-- ══ SWAG ══ -->
  <!-- <SwagSection /> -->

  <!-- ══ STYLE. PAWS. PURPOSE. ══ -->
  <section class="band band--teal band--tight spp-section" aria-labelledby="spp-h">
    <div class="container">
      <div class="spp-grid">
        <div class="spp-text">
          <p class="eyebrow">About the Events</p>
          <h2 id="spp-h">Style. Paws. Purpose.</h2>
          <p class="spp-sub">Every Pawstep Makes a Difference</p>
          <p class="prose">
            Every ticket, sponsorship, and tail wag helps <a href="https://eyespyfoundation.org" target="_blank" rel="noopener">Eye Spy Foundation</a>
            support programs that connect the blind and low vision community
            with resources, technology, and opportunities — while helping
            train future guide dogs through <a href="https://www.leaderdog.org/" target="_blank" rel="noopener">Leader Dogs for the Blind</a>.
          </p>
          <a class="btn btn--primary" href="/beneficiaries/">View the Beneficiaries</a>
        </div>
        <img
          class="spp-photo"
          src="/images/schedule/runway-hero.webp"
          alt="A golden retriever puppy wearing a Future Leader Dog bandana"
          width="1600"
          height="1200"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ══ SHARE WITH A FRIEND ══ -->
  <ShareSection />
<style>
  .spp-grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  @media (min-width: 52rem) {
    .spp-grid { grid-template-columns: 1fr 1fr; gap: var(--space-xl); }
  }

  .spp-text { display: flex; flex-direction: column; gap: var(--space-xs); }

  .spp-sub {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-accent);
  }

  .spp-grab {
    margin: var(--space-s) 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-2);
  }

  .spp-photo {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }
</style>
</BaseLayout>
