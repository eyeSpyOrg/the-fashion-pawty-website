---
/**
 * Volunteer — recruit event volunteers for The Fashion PAWty.
 * TODO: Replace formGuid with the real HubSpot Volunteer form GUID
 *       once the form is created in the portal.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HubSpotForm from '../components/HubSpotForm.astro';
import { SITE } from '../config/site.js';
---

<BaseLayout
  title="Volunteer at The Fashion PAWty"
  description="Volunteer at The Fashion PAWty on Sep 26 in Jacksonville. Join our crew and help raise funds for the blind and low vision community through the Eye Spy Foundation."
>
  <!-- ══ HERO ══ -->
  <section class="band band--teal band--tight">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">Get Involved</p>
          <h1>Lend a Paw</h1>
          <p class="prose lead">
            Every volunteer who shows up on September 26 is helping the Eye Spy
            Foundation reach more people in the blind and low vision community.
            This event is how we fund that work — and it doesn't happen without
            people like you. Join our crew and be part of something that matters.
          </p>
          <div class="hero-actions">
            <a class="btn btn--primary btn--lg" href="#volunteer-form">Sign Up to Volunteer</a>
          </div>
          <p class="pass-note">
            Volunteers who plan to eat and enjoy mocktails are asked to purchase
            a <a href={SITE.event.ticketUrl} target="_blank" rel="noopener">$30 event pass</a> to help us cover costs.
            Your support goes directly to the cause.
          </p>
        </div>
        <div class="glance-panel" role="list" aria-label="Volunteer details">
          <div class="glance-item" role="listitem">
            <span class="glance-label">Date</span>
            <span class="glance-value">Saturday, September 26, 2026</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Volunteer Hours</span>
            <span class="glance-value">3:00 PM – 7:30 PM ET</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Venue</span>
            <span class="glance-value">Happy Brew · 3200 Hendricks Ave · Jacksonville, FL</span>
          </div>
          <div class="glance-item" role="listitem">
            <span class="glance-label">Commitment</span>
            <span class="glance-value">~4.5 hours (setup through event close)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ FORM ══ -->
  <section id="volunteer-form" class="band" aria-label="Volunteer sign-up form">
    <div class="container container--narrow">
      <div class="form-wrap">
        <p class="eyebrow">Sign Up</p>
        {/* TODO: Replace this GUID with the real HubSpot Volunteer Signup form GUID */}
        <HubSpotForm
          formGuid="00000000-0000-0000-0000-000000000000"
          heading="Volunteer Sign-Up"
          submitLabel="Submit Volunteer Application"
          fields={[
            { name: 'firstname', label: 'First name', type: 'text', required: true, autocomplete: 'given-name' },
            { name: 'lastname', label: 'Last name', type: 'text', required: true, autocomplete: 'family-name' },
            { name: 'email', label: 'Email address', type: 'email', required: true },
            { name: 'phone', label: 'Phone number', type: 'tel', autocomplete: 'tel' },
            { name: 'volunteer_role', label: 'Preferred role (optional)', type: 'text' },
            { name: 'message', label: 'Anything else we should know?', type: 'textarea' },
          ]}
        />
        <p class="form-note">
          Questions? Email us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-actions { display: flex; gap: var(--space-s); flex-wrap: wrap; margin-top: var(--space-m); }

  .pass-note {
    margin-top: var(--space-s);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 42ch;
  }
  .pass-note a {
    color: var(--color-accent);
    font-weight: 600;
  }
  .pass-note a:hover { text-decoration: underline; }

  /* Glance panel — event-at-a-glance on the hero right column */
  .glance-panel {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    box-shadow: var(--shadow-sm);
  }
  .glance-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .glance-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .glance-value { font-weight: 600; font-size: var(--step-0); }

  /* Form panel */
  .form-wrap {
    background: var(--color-teal-tint);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-l);
    box-shadow: var(--shadow-sm);
  }
  .form-wrap :global(.hs-form) { max-width: none; }
  .form-wrap :global(.hs-form h2) { margin-top: 0; }
  html[data-a11y-contrast='high'] .form-wrap { background: var(--color-surface); }
  .form-note {
    margin-top: var(--space-m);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
